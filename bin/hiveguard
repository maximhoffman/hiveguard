#!/usr/bin/env bash
# 🐝 hiveguard — single entry point for the toolkit.
#
# Run `hiveguard <command> --help` for a command's own options and details.
#
# Actions:
#   hiveguard add   <mgr> <pkg> [args]   # gated install: OSV-check, then install
#   hiveguard scan  [path|--global]      # scan installed deps for known vulns
#   hiveguard daily [path]               # full scan → HTML report + notification
#   hiveguard brew  [args]               # changelogs of outdated formulae, pre-upgrade
#   hiveguard ack   <path> [pkg]         # mute a project/finding in the daily report
#   hiveguard mark  status|on|off|clear|hook   # Finder tags on flagged folders
#
# Management:
#   hiveguard schedule on|off|status   # schedule the daily scan (time + folders)
#   hiveguard doctor [--fix]   # diagnose install/migration health (repair with --fix)
#   hiveguard update       # git pull the repo + re-run installer (scripts & agent)
#   hiveguard version      # installed version (git describe)
#   hiveguard where        # print the repo path
#   hiveguard help         # this help
#
# The installed ~/bin/hiveguard is a symlink into the cloned repo, so `update`
# just pulls that repo. `hvg` is a short alias for `hiveguard` (e.g. `hvg
# brew`). There are no separate per-tool commands — everything is a subcommand
# of hiveguard.
set -euo pipefail

# -- resolve the repo root by following this script's symlink chain (BSD-safe) -
src="$0"
hops=0
while [ -L "$src" ] && [ "$hops" -lt 10 ]; do
  t="$(readlink "$src")"
  case "$t" in
    /*) src="$t" ;;
    *)  src="$(cd "$(dirname "$src")" && pwd)/$t" ;;
  esac
  hops=$((hops + 1))
done
REPO="$(cd "$(dirname "$src")/.." && pwd)"
BIN="$REPO/bin"

# -- how was hiveguard installed? brew ships a VERSION file; git has .git ------
install_method() {
  if [ -f "$REPO/VERSION" ] && grep -q '^method=brew$' "$REPO/VERSION"; then
    echo brew
  elif [ -e "$REPO/.git" ]; then
    echo git
  else
    echo unknown
  fi
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift || true

case "$cmd" in
  add)   exec "$BIN/safe-add" "$@" ;;
  scan)  exec "$BIN/deps-audit" "$@" ;;
  daily) exec "$BIN/osv-daily" "$@" ;;
  brew)  exec "$BIN/brew-changelog" "$@" ;;
  ack)   exec "$BIN/osv-ack" "$@" ;;
  mark)  exec "$BIN/folder-mark" "$@" ;;
  schedule) exec "$BIN/daily-schedule" "$@" ;;
  doctor)   exec "$BIN/doctor" "$@" ;;

  update)
    if [ "$(install_method)" = brew ]; then
      echo "🐝 Updating hiveguard via Homebrew"
      exec brew upgrade hiveguard
    fi
    echo "🐝 Updating hiveguard ($REPO)"
    if ! git -C "$REPO" pull --ff-only; then
      echo "⚠ git pull could not fast-forward — resolve it manually in $REPO" >&2; exit 1
    fi
    echo "🔧 Re-running the installer (symlinks + launchd agent)"
    "$REPO/install.sh" "$@"
    echo "✅ Updated. A new report appears on the next scan (or run: hiveguard daily)"
    ;;
  version|--version|-v)
    if [ -f "$REPO/VERSION" ]; then
      v="$(sed -n 's/^version=//p' "$REPO/VERSION" | head -n1)"
      echo "$v (brew)"
    else
      git -C "$REPO" describe --tags --always --dirty 2>/dev/null || git -C "$REPO" rev-parse --short HEAD
    fi
    ;;
  where)
    echo "$REPO"
    ;;
  help|-h|--help|"")
    if [ -t 1 ]; then
      awk -v pretty=1 -f "$BIN/help.awk" "$src"
      # append a one-line health verdict (doctor --quiet prints ok|warn|fail).
      # a doctor failure or an unrecognized word prints no line — never breaks help.
      verdict="$("$BIN/doctor" --quiet 2>/dev/null || true)"
      case "$verdict" in
        ok)   printf '\n\033[32m✓ everything looks healthy\033[0m\n' ;;
        warn) printf '\n\033[33m⚠ some checks need attention — run `hiveguard doctor` for details\033[0m\n' ;;
        fail) printf '\n\033[31m✖ problems found — run `hiveguard doctor` for details\033[0m\n' ;;
      esac
    else
      awk -v pretty=0 -f "$BIN/help.awk" "$src"
    fi
    ;;
  *)
    echo "unknown command: $cmd (see: hiveguard help)" >&2; exit 2 ;;
esac
