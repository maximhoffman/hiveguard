#!/usr/bin/env bash
# deps-audit — scan dependencies for known vulnerabilities and malicious packages.
# Layer 1: osv-scanner (OSV vulnerability database: npm, PyPI, Go, Rust, ...).
# Layer 2: a fresh bumblebee threat catalog (known-compromised packages).
#
# Usage:
#   deps-audit                 # scan the project in the current directory (lockfiles)
#   deps-audit <path>          # scan a project at <path>
#   deps-audit --global        # scan global installs (npm -g, uv tools)
#   deps-audit --no-refresh    # don't refresh the bumblebee catalog first
#
# Run it BEFORE and AFTER updating dependencies to compare what changed.
set -euo pipefail

REFRESH=1; SCOPE="project"; TARGET="$PWD"
while [ $# -gt 0 ]; do
  case "$1" in
    --global) SCOPE="global" ;;
    --no-refresh) REFRESH=0 ;;
    -h|--help) grep '^#' "$0" | grep -v '/usr/bin/env' | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "unknown flag: $1" >&2; exit 2 ;;
    *) TARGET="$1" ;;
  esac; shift
done

command -v osv-scanner >/dev/null || { echo "osv-scanner not found (brew install osv-scanner)"; exit 1; }

# --- Layer 2: bumblebee threat catalog --------------------------------------
if [ "$REFRESH" -eq 1 ] && [ -d "$HOME/bumblebee-src/.git" ]; then
  echo "🐝 bumblebee: refreshing threat catalog..."
  git -C "$HOME/bumblebee-src" pull --quiet 2>/dev/null \
    && echo "   catalog up to date" \
    || echo "   could not refresh (offline?) — using what's on disk" >&2
fi

# --- Layer 1: osv-scanner ---------------------------------------------------
run_osv() {  # $1 = dir
  echo; echo "🔎 osv-scanner: $1"
  # exit 1 = vulnerabilities found; don't let set -e kill the script
  osv-scanner scan --recursive "$1" 2>/dev/null || true
}

if [ "$SCOPE" = "global" ]; then
  echo "== Global installs =="
  NPM_G="$(npm root -g 2>/dev/null || echo "$(brew --prefix 2>/dev/null || echo /opt/homebrew)/lib/node_modules")"
  [ -d "$NPM_G" ] && run_osv "$NPM_G"
  UV_TOOLS="$HOME/.local/share/uv/tools"
  [ -d "$UV_TOOLS" ] && run_osv "$UV_TOOLS"
  echo; echo "ℹ️  Homebrew formulae are not covered by osv-scanner — use brew-changelog for those."
else
  [ -d "$TARGET" ] || { echo "no such directory: $TARGET"; exit 1; }
  echo "== Project: $TARGET =="
  run_osv "$TARGET"
fi

echo; echo "✅ done. Empty output above = no known issues (does not rule out a zero-day)."
