PYEOF

# active/acked counts computed by python (notification + log use the ACTIVE ones)
ACTIVE_PROJECTS=0; ACTIVE_PKGS=0; ACTIVE_VULNS=0; ACTIVE_CRIT=0
ACKED_PROJECTS=0; ACKED_PKGS=0; ACKED_VULNS=0; ACKED_CRIT=0
NEW_VULNS=0; RESOLVED_VULNS=0
[ -f "$COUNTS" ] && . "$COUNTS"

# "· N new" suffix (notification + done-line) and " new=N" (log), only when > 0
new_suffix=""; new_log=""
if [ "${NEW_VULNS:-0}" -gt 0 ]; then new_suffix=" · $NEW_VULNS new"; new_log=" new=$NEW_VULNS"; fi

echo "[$STAMP] projects=$ACTIVE_PROJECTS pkgs=$ACTIVE_PKGS vulns=$ACTIVE_VULNS crit=$ACTIVE_CRIT$new_log (acked: vulns=$ACKED_VULNS pkgs=$ACKED_PKGS) → $REPORT" >> "$LOGDIR/osv-daily.log"

# notification only on ACTIVE (non-acknowledged) findings
if [ "${ACTIVE_VULNS:-0}" -gt 0 ] && command -v terminal-notifier >/dev/null; then
  terminal-notifier -title "osv-daily: vulnerabilities found" \
    -message "$ACTIVE_PROJECTS project(s), $ACTIVE_PKGS package(s), $ACTIVE_VULNS total ($ACTIVE_CRIT critical)$new_suffix" \
    -open "file://$REPORT" -sender com.apple.Terminal 2>/dev/null || true
fi
echo "✅ done: $ACTIVE_VULNS active vulnerabilities across $ACTIVE_PROJECTS projects ($ACKED_VULNS acknowledged)$new_suffix → $REPORT"
