(function(){{
  var b=document.getElementById('toggleAll');
  if(b){{
    b.addEventListener('click',function(){{
      var ds=[].slice.call(document.querySelectorAll('details.proj:not(.acked)'));
      var open=ds.some(function(d){{return !d.open;}});
      ds.forEach(function(d){{d.open=open;}});
      b.textContent=open?'Collapse all':'Expand all';
    }});
  }}
  document.addEventListener('click',function(e){{
    var btn=e.target.closest('.cp');
    if(!btn) return;
    e.preventDefault(); e.stopPropagation();   // don't toggle the <details>
    var cmd=btn.getAttribute('data-cmd');
    function done(){{
      var orig=btn.innerHTML;
      btn.classList.add('ok'); btn.textContent='✓ copied';
      setTimeout(function(){{btn.classList.remove('ok'); btn.innerHTML=orig;}},1500);
    }}
    function fb(){{
      var t=document.createElement('textarea'); t.value=cmd;
      t.style.position='fixed'; t.style.top='0'; t.style.opacity='0';
      document.body.appendChild(t); t.focus(); t.select();
      try{{document.execCommand('copy');}}catch(err){{}}
      document.body.removeChild(t); done();
    }}
    if(navigator.clipboard&&navigator.clipboard.writeText){{ navigator.clipboard.writeText(cmd).then(done,fb); }}
    else {{ fb(); }}
  }});
}})();
</script>'''
