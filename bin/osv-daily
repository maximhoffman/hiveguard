#!/usr/bin/env bash
# osv-daily — daily vulnerability scan of all your projects (run by launchd).
# One scan -> JSON -> compact HTML report + macOS notification on findings.
# Also refreshes the bumblebee threat catalog so the install-gate stays current.
#
#   osv-daily              # interactive: open today's report, else scan
#   osv-daily <path>...    # same, scanning one or more given folders
#   osv-daily --open [--at <anchor>]  # open the last report (never scans); --at jumps to a report anchor
#   osv-daily --rescan     # force a fresh scan now (never prompts)
#   osv-daily --if-due     # scan only if today's report is missing/stale
#   osv-daily --probe <p>  # internal: scan ONE project root into its own report
#   osv-daily --render     # rebuild the last report from the saved scan results + current acks (no scan)
#   osv-daily -h|--help    # show this help
#
# With no path, the scan falls back to the folders configured for the daily
# schedule (`hiveguard schedule on --hour H <folder>...`); passing a path
# overrides that for this run only. There is no whole-home default — if no
# schedule is configured you must name a folder. (A background scan of the
# whole home folder is slow and, on macOS, the OS blocks a background agent
# from reading protected folders like Documents / Desktop / Downloads, so it
# silently finds nothing.) A fixed set of heavyweight
# dirs (Library, Caches, node_modules, .git, .cargo, go, …) is excluded at scan
# time so pointing at a large tree stays fast.
#
# Open-or-rescan: with no flag on an interactive terminal, if today's report
# already exists it opens and asks whether to rescan; otherwise it scans.
# Non-interactive runs (launchd, pipes) always scan silently.
#
# Acknowledgements: projects/packages muted via `hiveguard ack` (stored in
# ~/.hiveguard/osv-acks.json) are excluded from the totals and the notification
# for the advisories known at ack time, and shown in a collapsed "Acknowledged"
# section. A genuinely NEW advisory in a muted item still surfaces and alerts
# ("new pierces the mute"), badged "muted"; its button ("mark as known" with the
# menu bar app, "mute" without) re-runs `hiveguard ack` to fold it in.
#
# Advisory details: each report row names its worst advisory (osv.dev link) and
# describes it in one line; clicking the description lists every advisory of
# the row with its CVE aliases, its own severity and fix, and the full text on a
# further click (plain text, never HTML). The scan saves the texts once per
# advisory under `render.advisories` of the state file, each description capped
# at 4000 characters (cut at a word boundary, marked truncated), so --render
# shows them too; a state saved before this has no texts and renders the plain
# IDs column. "Fixed in" is the fix for the package on its own version line.
# A severity of 0 or unknown reads "no score" and ranks after HIGH, before MED.
# The scan also writes ~/.hiveguard/osv-last-scan.json (override: HIVEGUARD_STATE)
# — the last scan's summary and the baseline for the "new since last scan" diff,
# and, under `render`, the normalised findings the report is built from.
# Every successful scan also upserts one row per scanned folder into
# ~/.hiveguard/osv-coverage.tsv (override: HIVEGUARD_COVERAGE), `folder<TAB>epoch`
# — how strict mode tells a never-scanned project from a known-clean one.
#
# --probe <path> is the internal one-project scan strict mode kicks off in the
# background: it never prompts, writes its report to ~/.hiveguard/osv-probe.html,
# leaves the daily report and the osv-last-scan.json baseline untouched, and
# still syncs that root's folder marker and its coverage row.
#
# Every non-probe run that reaches the scan step records its outcome in
# ~/.hiveguard/osv-run.json (override: HIVEGUARD_RUN): ok/failed, counts, the
# advisories new in this run and the "unseen" ones carried over until the report
# is opened — the file the menu bar app reads (via `hiveguard status`).
# Its `active` list holds every active finding of the run (one entry per row of
# the report's Active section, ids not covered by an ack at scan time) — what
# the app checks report links against.
# While the scanner runs, ~/.hiveguard/osv-daily.pid (override: HIVEGUARD_SCAN_PID)
# holds this run's pid; it is removed when the run ends.
# Notifier handoff: while the menu bar app is running (live pid in
# ~/.hiveguard/menubar.pid, override: HIVEGUARD_APP_PID) the app notifies and
# this script skips terminal-notifier; otherwise it notifies as always.
# A failed scan (scanner error or no output) records ok:false with the error,
# logs a FAILED line and keeps the previous report, baseline and markers.
# Every time the report is opened via `hiveguard daily --open` (plain or with
# --at) osv-daily stamps ~/.hiveguard/osv-report-opened (override:
# HIVEGUARD_REPORT_OPENED) with the current time; the "unseen" carry-over
# above and the menu bar app both key off that stamp.
#
# Report action buttons: when the menu bar app is running at report time (the
# same live-pid check as the notifier handoff) the Active section's buttons
# become hiveguard:// links the app handles — "mark as known" (ack <src> <pkg>,
# or ack <src> on a row a project mute covered),
# "mark project as known" (ack <src>) and, only with strict mode on and for a
# root strict mode would block, "pause strict 1 h / 2 h" (strict pause). The
# app always asks for confirmation; the terminal command stays behind a small
# "copy" button. --probe reports never carry links, and with the app not
# running the report is exactly as before. Grammar: docs/report-links.md.
#
# Re-rendering: --render rebuilds the daily report without scanning, from the
# saved scan results (the `render` block of osv-last-scan.json) and the CURRENT
# acknowledgements, through the same code the scan uses — so right after a scan
# it reproduces that scan's report byte for byte, and after an ack change it is
# what a scan with those acks would have written. `hiveguard ack` (mute,
# --remove, --clear) runs it after every change. It reads the state, the ack
# store, the config and the app/scan pid files; the app and strict gates of the
# action buttons apply at render time. It writes the report (atomically, keeping
# the report's modification time — the scan's — so --if-due and the
# open-or-rescan gate never see a fresh report because of an ack), re-syncs the
# folder markers with the saved scan targets, and logs one `render` line. It
# never writes the state, osv-run.json, the coverage file, the opened stamp, the
# scan pid file, the probe report or the ack store, and never notifies.
# Exit codes: 0 rendered; 1 render failed; 2 usage; 3 nothing to render from
# (no saved scan, or one that predates re-rendering — run a scan); 4 a scan is
# in progress (it writes a fresh report itself).
set -euo pipefail
export PATH="${HIVEGUARD_TOOL_PATH:+$HIVEGUARD_TOOL_PATH:}/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# --- argument parsing ------------------------------------------------------
print_header() {
  # print this file's top comment block (what --help shows)
  local here; here="$(cd "$(dirname "$0")" && pwd)"
  if [ -t 1 ]; then awk -v pretty=1 -f "$here/help.awk" "$0"; else awk -v pretty=0 -f "$here/help.awk" "$0"; fi
}
usage_err() {
  echo "usage: osv-daily [--open [--at <anchor>] | --rescan | --if-due] [path...]" >&2
  echo "       osv-daily --probe <path>" >&2
  echo "       osv-daily --render" >&2
  exit 2
}
# Canonicalize a path (resolve symlinks) — best-effort, prints the input on
# failure. The terminal hook matches a realpath'd $PWD and folder-mark compares
# canonical roots against canonical targets, so scan roots/targets MUST be
# realpath'd or a marker silently won't match.
canon_path() {
  local p="$1" c
  c="$(cd "$p" 2>/dev/null && pwd -P)" && { printf '%s' "$c"; return 0; }
  python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$p" 2>/dev/null \
    || printf '%s' "$p"
}

open_flag=0; rescan_flag=0; ifdue_flag=0; probe_flag=0; render_flag=0; PROBE_PATH=""; AT_ANCHOR=""; TARGETS=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) print_header; exit 0 ;;
    --open)    open_flag=1 ;;
    --rescan)  rescan_flag=1 ;;
    --if-due)  ifdue_flag=1 ;;
    --render)  render_flag=1 ;;
    --at)
      shift
      [ $# -gt 0 ] || { echo "osv-daily: --at needs an anchor" >&2; usage_err; }
      AT_ANCHOR="$1" ;;
    --probe)
      shift
      [ $# -gt 0 ] || { echo "osv-daily: --probe needs a path" >&2; usage_err; }
      probe_flag=1; PROBE_PATH="$1" ;;
    --)        shift; while [ $# -gt 0 ]; do TARGETS+=("$1"); shift; done; break ;;
    -*)        echo "osv-daily: unknown option: $1" >&2; usage_err ;;
    *)         TARGETS+=("$1") ;;
  esac
  shift
done
if [ "$open_flag" = 1 ] && { [ "$rescan_flag" = 1 ] || [ "$ifdue_flag" = 1 ] || [ "$render_flag" = 1 ]; }; then
  echo "osv-daily: --open cannot be combined with --rescan, --if-due or --render" >&2
  exit 2
fi
if [ -n "$AT_ANCHOR" ] && [ "$open_flag" != 1 ]; then
  echo "osv-daily: --at requires --open" >&2
  exit 2
fi
if [ -n "$AT_ANCHOR" ]; then
  case "$AT_ANCHOR" in
    [pf]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
    *) echo "osv-daily: invalid anchor: $AT_ANCHOR" >&2; exit 2 ;;
  esac
fi
# --probe is the strict-mode background scan of ONE project root: exactly one
# path, no mode flags, its own report, no state baseline (see below).
if [ "$probe_flag" = 1 ]; then
  if [ "$open_flag" = 1 ] || [ "$rescan_flag" = 1 ] || [ "$ifdue_flag" = 1 ] \
     || [ "$render_flag" = 1 ] || [ "${#TARGETS[@]}" -gt 0 ]; then
    echo "osv-daily: --probe takes exactly one path and cannot be combined with --open, --rescan, --if-due or --render" >&2
    exit 2
  fi
  TARGETS=("$PROBE_PATH")
fi
# --render rebuilds the last daily report from the saved scan: no path, no
# other mode (see "Re-rendering" in the header).
if [ "$render_flag" = 1 ]; then
  if [ "$rescan_flag" = 1 ] || [ "$ifdue_flag" = 1 ] || [ "$open_flag" = 1 ] \
     || [ "$probe_flag" = 1 ] || [ "${#TARGETS[@]}" -gt 0 ]; then
    echo "osv-daily: --render takes no path and cannot be combined with --open, --rescan, --if-due or --probe" >&2
    exit 2
  fi
fi
# A single, stable, comparable string representing the whole scanned set — used
# for the report header and the state file's `target` (so a later diff can tell
# "same target set"). Space-joined; empty until we actually know we're scanning.
TARGET_STR=""
[ "${#TARGETS[@]}" -gt 0 ] && TARGET_STR="${TARGETS[*]}"

# Directory exclusions passed to osv-scanner (built below, once the targets are
# known). osv-scanner already skips .gitignore'd files, which covers most
# in-repo node_modules; these keep a broad target from crawling trees that hold
# OTHER people's packages — which come back as dozens of red "projects" the user
# can't fix.
#   EXCLUDE_ANY  — skipped at any depth below a target: VCS/build/package caches
#                  and tool homes (package managers, editor/agent plugin stores).
#                  Inside a repo they are tool state, not the project
#                  (`.claude/worktrees/*` would only duplicate the repo's findings).
#   EXCLUDE_HOME — skipped only directly in $HOME (~/Library, ~/go, …): inside a
#                  repo a `go/` or `Library/` folder can be real project code.
EXCLUDE_ANY=(.git node_modules .cache .Trash .cargo .rustup .npm .gradle .m2
  .bun .pnpm-store .deno .nvm .pyenv .rbenv .gem .claude .codex .cursor .vscode
  .vscode-server .lmstudio .serena .tldrc .ollama)
EXCLUDE_HOME=(Library Applications Caches go)

REPORT="$HOME/.hiveguard/osv-projects.html"
STATE="${HIVEGUARD_STATE:-$HOME/.hiveguard/osv-last-scan.json}"
COVERAGE="${HIVEGUARD_COVERAGE:-$HOME/.hiveguard/osv-coverage.tsv}"
RUN="${HIVEGUARD_RUN:-$HOME/.hiveguard/osv-run.json}"
SCAN_PID="${HIVEGUARD_SCAN_PID:-$HOME/.hiveguard/osv-daily.pid}"
OPENED="${HIVEGUARD_REPORT_OPENED:-$HOME/.hiveguard/osv-report-opened}"
APP_PID="${HIVEGUARD_APP_PID:-$HOME/.hiveguard/menubar.pid}"
CONFIG="${HIVEGUARD_CONFIG:-$HOME/.hiveguard/config}"
# A probe writes its own report and never reads or writes the daily baseline.
[ "$probe_flag" = 1 ] && REPORT="$HOME/.hiveguard/osv-probe.html"

# --- open-or-rescan gate (evaluated before any scan) -----------------------
report_is_today() { [ -f "$REPORT" ] && [ "$(stat -f %Sm -t %Y-%m-%d "$REPORT" 2>/dev/null)" = "$(date +%Y-%m-%d)" ]; }

# Stamp "the report was just opened" (atomic tmp+mv) — every open_report call
# writes this, regardless of --at, so the menu bar app and the next scan's
# "unseen" carry-over both see it.
write_opened() {
  mkdir -p "$(dirname "$OPENED")" 2>/dev/null || true
  date +%s > "$OPENED.tmp" && mv "$OPENED.tmp" "$OPENED"
}
# Is the menu bar app running? (live pid in $APP_PID; a stale pid after a crash
# fails kill -0). Gates the report's action links and the notifier handoff.
app_running() { [ -f "$APP_PID" ] && kill -0 "$(cat "$APP_PID" 2>/dev/null)" 2>/dev/null; }
# Read a key from the hiveguard config (same as strict-mode's config_get).
config_get() {
  local key="$1" def="$2" val=""
  if [ -f "$CONFIG" ]; then
    val="$(awk -F= -v k="$key" '$1==k{sub(/^[^=]*=/,"");v=$0} END{print v}' \
           "$CONFIG" 2>/dev/null || true)"
  fi
  if [ -n "$val" ]; then printf '%s' "$val"; else printf '%s' "$def"; fi
}
# Open the report, jumping to $AT_ANCHOR when set. LaunchServices drops URL
# fragments on file: URLs before the browser sees them (both open(1) and
# AppleScript `open location`), so a non-empty anchor writes a tiny jump page
# next to the report (osv-open-at.html) that redirects inside the browser to
# `<report>#<anchor>` — a relative URL, so the report path needs no escaping;
# the anchor is already validated as [pf]-<12 hex>. If the jump page can't be
# written, plain `open` of the report. Always stamps the opened file.
open_report() {
  if [ -n "$AT_ANCHOR" ]; then
    local jump
    jump="$(dirname "$REPORT")/osv-open-at.html"
    if printf '<!doctype html><meta charset="utf-8"><title>hiveguard</title><script>location.replace("%s#%s")</script>\n' \
         "$(basename "$REPORT")" "$AT_ANCHOR" > "$jump" 2>/dev/null; then
      open "$jump"
    else
      open "$REPORT"
    fi
  else
    open "$REPORT"
  fi
  write_opened
}

# --render: rebuild the daily report from the last scan's saved records and the
# current acks (see "Re-rendering" in the header). Refuses — one stderr line,
# every file untouched — when there is nothing to render from (rc 3) or a scan
# is running (rc 4: its python reads the acks at the end and writes a fresh
# report; rendering now could overwrite that with the previous scan's data).
render_report() {
  if [ ! -f "$STATE" ]; then
    echo "osv-daily: no saved scan to render from — run: hiveguard daily <folder>" >&2
    return 3
  fi
  local _spid
  _spid="$(cat "$SCAN_PID" 2>/dev/null || true)"
  if [ -f "$SCAN_PID" ] && kill -0 "$_spid" 2>/dev/null; then
    echo "osv-daily: a scan is in progress (pid $_spid); it writes a fresh report itself" >&2
    return 4
  fi
  ACKS="${HIVEGUARD_ACKS:-$HOME/.hiveguard/osv-acks.json}"
  COUNTS="$(mktemp)"; MARKS="$(mktemp)"; TARGETS_OUT="$(mktemp)"
  trap 'rm -f "$COUNTS" "$MARKS" "$TARGETS_OUT"' EXIT
  LOGDIR="$HOME/.hiveguard"; mkdir -p "$LOGDIR" "$(dirname "$REPORT")"
  STRICT_ON=0; [ "$(config_get strict 0)" = 1 ] && STRICT_ON=1
  APP_RUNNING=0; app_running && APP_RUNNING=1
  local _rc=0
  RENDER=1 STATE="$STATE" OUT="$REPORT" ACKS="$ACKS" COUNTS="$COUNTS" MARKS="$MARKS" \
    TARGETS_OUT="$TARGETS_OUT" APP_RUNNING="$APP_RUNNING" STRICT_ON="$STRICT_ON" PROBE=0 \
    JSON="" RUN="" OPENED="" SCAN_TARGETS="" STAMP="" TARGET="" STARTED="" SCAN_RC="" \
    report_python || _rc=$?
  if [ "$_rc" = 3 ]; then
    return 3            # python printed "the saved scan predates report re-rendering"
  elif [ "$_rc" != 0 ]; then
    echo "osv-daily: render failed (python exit $_rc)" >&2
    return 1
  fi

  ACTIVE_PROJECTS=0; ACTIVE_PKGS=0; ACTIVE_VULNS=0; ACTIVE_CRIT=0
  ACKED_PROJECTS=0; ACKED_PKGS=0; ACKED_VULNS=0; ACKED_CRIT=0
  NEW_VULNS=0; RESOLVED_VULNS=0
  MARK_ACTIVE=0; MARK_ACKED=0; SCAN_STAMP=""
  [ -f "$COUNTS" ] && . "$COUNTS"

  # Folder markers from the same desired set, with the saved scan targets —
  # best-effort, exactly as the scan does it.
  local _t _mark_args=()
  while IFS= read -r _t; do
    if [ -n "$_t" ]; then _mark_args+=(--target "$_t"); fi
  done < "$TARGETS_OUT"
  if [ "${#_mark_args[@]}" -gt 0 ]; then
    "$(dirname "$0")/folder-mark" sync "${_mark_args[@]}" < "$MARKS" 2>/dev/null || true
  fi

  local new_log="" mark_log log_kind="render "
  if [ "${NEW_VULNS:-0}" -gt 0 ]; then new_log=" new=$NEW_VULNS"; fi
  mark_log=" markers=R${MARK_ACTIVE:-0},Y${MARK_ACKED:-0}"
  echo "[$(date '+%Y-%m-%d %H:%M')] ${log_kind}projects=$ACTIVE_PROJECTS pkgs=$ACTIVE_PKGS vulns=$ACTIVE_VULNS crit=$ACTIVE_CRIT$new_log (acked: vulns=$ACKED_VULNS pkgs=$ACKED_PKGS)$mark_log → $REPORT" >> "$LOGDIR/osv-daily.log"
  echo "✅ report refreshed (scan of $SCAN_STAMP): $ACTIVE_VULNS active vulnerabilities across $ACTIVE_PROJECTS projects ($ACKED_VULNS acknowledged) → $REPORT"
  return 0
}

# print the recovered summary from the last scan's state file (Part B).
print_last_summary() {
  STATE="$STATE" REPORT="$REPORT" python3 - <<'PYEOF' || true
import json, os, sys
state, report = os.environ["STATE"], os.environ["REPORT"]
try:
    with open(state) as f:
        s = json.load(f)
    c = s["counts"]; a = c["active"]; k = c["acked"]
    new = f" · {c['new_vulns']} new" if c.get("new_vulns", 0) > 0 else ""
    print(f"Last scan: {s['stamp']} ({s['target']})")
    print(f"  active: {a['projects']} project(s), {a['pkgs']} package(s), "
          f"{a['vulns']} vuln(s), {a['crit']} critical{new}")
    print(f"  acknowledged: {k['vulns']} vuln(s) in {k['pkgs']} package(s)")
    print(f"Report: {report}")
except Exception:
    print("Summary unavailable (no state from a previous scan — it will appear after the next scan).")
PYEOF
}

# The report python, shared by the scan and --render (one code path, so the two
# cannot drift). Scan mode (RENDER unset): raw scanner JSON → merged results →
# baseline → per-package records; render mode (RENDER=1): the records saved in
# the state's `render` block. Everything after the records (acks, fragments,
# markers, counts, HTML) is common. Called with an env prefix.
report_python() {
  python3 <<'PYEOF'
import json, os, sys, html, re, shlex, hashlib, time, urllib.parse
def ig(k, dv=""):
    return os.environ.get(k, dv)

# RENDER=1 → --render: rebuild the report from the records the last scan saved
# in the state's `render` block (no scanner JSON, no merge, no baseline).
render = ig("RENDER", "0") == "1"

# h12 = first 12 hex chars of SHA-1 — the report's DOM anchors (p-/f-, section
# 2.7) and osv-run.json's "anchor"/"project_anchor" (below) are the SAME ids,
# computed with this one function, so `hiveguard daily --open --at <id>` from
# a run-file id always lands on the matching report element.
def h12(s):
    return hashlib.sha1(s.encode()).hexdigest()[:12]

# --- dedup scan results by source path -------------------------------------
# osv-scanner can emit the SAME source.path more than once (multiple extractors
# over one manifest, e.g. a requirements.txt). Left as-is that double-counts
# projects/packages/vulns everywhere. Merge results by path up front so every
# tally, finding, and report row below is computed from one entry per path.
#   - group results by source.path (keep the first result's other source fields)
#   - within a group, merge packages by package name: union each package's
#     vulnerabilities deduped by vuln id (keep the first package dict's other
#     fields); concatenate groups so the later max_severity is the group maximum.
def merge_results(results):
    by_path, order = {}, []
    for r in results:
        path = (r.get("source", {}) or {}).get("path", "")
        grp = by_path.get(path)
        if grp is None:
            grp = by_path[path] = {"source": dict(r.get("source", {}) or {}),
                                   "packages": {}, "order": []}
            order.append(path)
        for p in r.get("packages", []) or []:
            name = (p.get("package", {}) or {}).get("name", "")
            mp = grp["packages"].get(name)
            if mp is None:
                mp = dict(p)   # keep this first package dict's other fields
                mp["vulnerabilities"] = list(p.get("vulnerabilities") or [])
                mp["groups"] = list(p.get("groups") or [])
                grp["packages"][name] = mp
                grp["order"].append(name)
            else:
                seen = {v.get("id") for v in mp["vulnerabilities"]}
                for v in (p.get("vulnerabilities") or []):
                    if v.get("id") not in seen:
                        mp["vulnerabilities"].append(v); seen.add(v.get("id"))
                mp["groups"].extend(p.get("groups") or [])   # max_severity = max
    return [{"source": by_path[path]["source"],
             "packages": [by_path[path]["packages"][n] for n in by_path[path]["order"]]}
            for path in order]

# --- project roots (records + Finder markers) ------------------------------
# A finding's source path is a manifest (a file). Its project ROOT is the
# nearest ancestor of the manifest's directory that contains a .git (dir OR
# file — worktrees), never walking above the scan target the finding is under;
# with no .git found, the root is the manifest's own directory. Roots are
# realpath'd (the terminal hook matches a realpath'd $PWD). Findings under one
# .git (a monorepo) collapse to ONE root. A root that IS itself a scan target is
# skipped (a stray manifest in a container dir must not tag the whole container).
# The canonical scan targets: from argv (SCAN_TARGETS) on a scan, from the
# saved `render.scan_targets` on --render (set below).
scan_targets = [os.path.realpath(t) for t in os.environ.get("SCAN_TARGETS", "").split("\n") if t]
# Under --probe the single scan target IS the project root (strict mode probes a
# resolved root), so the "a root that is a scan target must not be marked" rule
# — meant to stop a stray manifest tagging a whole container dir — is disabled.
probe = os.environ.get("PROBE", "0") == "1"
# Report action links (hiveguard://, docs/report-links.md): only while the menu
# bar app is running at report time, never in a probe report. Pause links also
# need strict mode on (and a root strict would block — a key of root_agg).
links_on = os.environ.get("APP_RUNNING", "0") == "1" and not probe
strict_on = os.environ.get("STRICT_ON", "0") == "1"

def finding_root(src):
    d0 = os.path.realpath(os.path.dirname(src))
    # the scan target containing this finding (longest matching prefix bounds the walk)
    bound = None
    for t in scan_targets:
        if d0 == t or d0.startswith(t + os.sep):
            if bound is None or len(t) > len(bound):
                bound = t
    if bound is None:
        bound = d0
    cur = d0
    while True:
        if os.path.exists(os.path.join(cur, ".git")):
            return cur
        if cur == bound:
            break
        parent = os.path.dirname(cur)
        if parent == cur:            # filesystem root — stop
            break
        cur = parent
    return d0

# --- versions and "Fixed in" ---------------------------------------------
# vkey: one sort key for every ecosystem's version strings as OSV ranges carry
# them. Strip one leading v/V and a +build suffix; release = the leading
# \d+(\.\d+)* with trailing zeros removed (1.0 == 1.0.0); tag = the rest minus
# one leading -/./_ : empty → the release (rank 1), "post…" → after it (rank 2),
# anything else (rc.2, 0, beta3, a1, a Go pseudo-version's date) → before it
# (rank 0). Equal ranks compare tag tokens (digit / letter runs): numbers
# numerically and before letters, letters case-insensitively, a prefix first.
# None when there is no leading digit — such a version compares with nothing.
_VREL = re.compile(r'\d+(?:\.\d+)*')
def vkey(v):
    if not isinstance(v, str):
        return None
    s = v.strip()
    if s[:1] in ("v", "V"):
        s = s[1:]
    s = s.split("+", 1)[0]
    m = _VREL.match(s)
    if not m:
        return None
    rel = [int(x) for x in m.group(0).split(".")]
    while rel and rel[-1] == 0:
        rel.pop()
    tag = s[m.end():]
    if tag[:1] in ("-", ".", "_"):
        tag = tag[1:]
    rank = 1 if not tag else (2 if tag.lower().startswith("post") else 0)
    toks = tuple((0, int(t)) if t.isdigit() else (1, t.lower())
                 for t in re.findall(r'\d+|[A-Za-z]+', tag))
    return (tuple(rel), rank, toks)

def vcmp(a, b):
    ka, kb = vkey(a), vkey(b)
    if ka is None or kb is None:
        return None
    return (ka > kb) - (ka < kb)

def _eco_norm(e):
    return (e or "").split(":", 1)[0].strip().lower()

def _name_norm(n, eco):
    n = (n or "").lower()
    return re.sub(r'[-_.]+', '-', n) if eco == "pypi" else n

def pkg_match(aff, name, eco):
    # an affected[] entry is a candidate iff its package is the scanned one:
    # ecosystem before any ":" and name case-insensitive (PyPI: PEP 503 runs of
    # -_. collapse to -). An entry without a package never matches.
    pk = aff.get("package") if isinstance(aff, dict) else None
    if not isinstance(pk, dict):
        return False
    e = _eco_norm(eco)
    if _eco_norm(pk.get("ecosystem")) != e:
        return False
    return _name_norm(pk.get("name"), e) == _name_norm(name, e)

def _spans(aff):
    # (introduced, fixed | None, last_affected | None) per affected span of the
    # entry's non-GIT ranges; a close event without an open span opens at "0".
    out = []
    for rng in aff.get("ranges") or []:
        if not isinstance(rng, dict) or (rng.get("type") or "").upper() == "GIT":
            continue
        intro = None
        for e in rng.get("events") or []:
            if not isinstance(e, dict):
                continue
            if e.get("introduced") is not None:
                if intro is None:
                    intro = e["introduced"]
            elif e.get("fixed") or e.get("last_affected"):
                out.append((intro if intro is not None else "0",
                            e.get("fixed") or None, e.get("last_affected") or None))
                intro = None
        if intro is not None:
            out.append((intro, None, None))
    return out

def advisory_fix(vuln, name, eco, version):
    # This advisory's fix for (name, eco, version): the `fixed` of the first span
    # (of the matching package's entries) that contains the version; a containing
    # span with no fix → no fix. No containing span → the lowest fix above the
    # version among those spans. Never a value from another package's entry.
    spans = []
    for aff in (vuln.get("affected") or []) if isinstance(vuln, dict) else []:
        if pkg_match(aff, name, eco):
            spans.extend(_spans(aff))
    kv = vkey(version)
    if kv is not None:
        for intro, fx, la in spans:
            if intro != "0":
                ki = vkey(intro)
                if ki is None or ki > kv:
                    continue
            if fx is not None:
                kf = vkey(fx)
                if kf is None or not kv < kf:
                    continue
            if la is not None:
                kl = vkey(la)
                if kl is None or kv > kl:
                    continue
            return fx or ""
    best = None
    for _intro, fx, _la in spans:
        kf = vkey(fx) if fx else None
        if kf is None or (kv is not None and not kf > kv):
            continue
        if best is None or kf < best[0]:
            best = (kf, fx)
    return best[1] if best else ""

def max_fix(fixes):
    # the highest fix under vkey; an unparsed fix loses to any parsed one, and
    # among only unparsed fixes the first is kept
    best = ""
    for f in fixes:
        if not best:
            best = f
            continue
        kb, kf = vkey(best), vkey(f)
        if kf is not None and (kb is None or kf > kb):
            best = f
    return best

# --- advisory texts (render.advisories) -------------------------------------
DETAILS_CAP = 4000
def adv_entry(v):
    det = v.get("details") if isinstance(v.get("details"), str) else ""
    truncated = len(det) > DETAILS_CAP
    if truncated:
        det = det[:DETAILS_CAP].rsplit(None, 1)[0]
    al = v.get("aliases")
    return {"summary": v.get("summary") if isinstance(v.get("summary"), str) else "",
            "aliases": [a for a in al if isinstance(a, str)] if isinstance(al, list) else [],
            "details": det, "truncated": truncated}

# --- the per-package records the report is built from ----------------------
# One record per vulnerable package, in scan iteration order (merged results
# order; a src's packages contiguous): {src, root, pkg, version, eco, ids
# (every advisory id, scanner order), id_sev (id → severity from the scanner's
# groups, max when an id spans groups), maxsev (package max over groups),
# id_fix (id → that advisory's fix for this package and version, only ids with
# a fix), fix (the highest of id_fix, or ""), new_ids (ids absent from the
# previous scan's baseline; [] when the baseline is not valid)}. A scan saves
# them in the state's `render` block, with adv_table (advisory id → summary,
# aliases, capped details) as `advisories`; --render reads both back instead of
# scanning. adv_table is None for a state saved without it → legacy IDs column.
if render:
    with open(os.environ["STATE"]) as f:
        saved = json.load(f)
    blk = saved.get("render") if isinstance(saved, dict) else None
    if not isinstance(blk, dict) or blk.get("schema") != 1:
        print("osv-daily: the saved scan predates report re-rendering — run: hiveguard daily",
              file=sys.stderr)
        sys.exit(3)
    records = blk["packages"]
    adv_table = blk.get("advisories")
    if not isinstance(adv_table, dict):
        adv_table = None
    scan_targets = blk["scan_targets"]
    stamp, target = saved["stamp"], saved["target"]
    saved_resolved = saved["counts"]["resolved_vulns"]
    # hand the saved scan targets back to the shell (folder-mark --target)
    tf = ig("TARGETS_OUT")
    if tf:
        with open(tf, "w") as f:
            f.write("".join(t + "\n" for t in scan_targets))
else:
    d = json.load(open(os.environ["JSON"]))
    d["results"] = merge_results(d.get("results", []))
    stamp, target = ig("STAMP"), ig("TARGET")

    # --- baseline for the "new since last scan" diff -----------------------
    # Read the EXISTING state file BEFORE this run overwrites it at the end. The
    # diff is valid ONLY when a prior scan exists AND it covered the same target
    # set — otherwise an absent/mismatched baseline would mark everything "new".
    prev = None
    try:
        with open(os.environ.get("STATE", "")) as f:
            prev = json.load(f)
    except Exception:
        prev = None
    baseline_findings = (prev or {}).get("findings", {}) or {}
    baseline_target = (prev or {}).get("target")
    baseline_valid = prev is not None and baseline_target is not None and baseline_target == target

    records = []
    root_of = {}
    adv_table = {}
    for r in d.get("results", []):
        src = r.get("source", {}).get("path", "")
        for p in r.get("packages", []):
            vulns = p.get("vulnerabilities") or []
            if not vulns: continue
            info = p.get("package", {})
            name = info.get("name", "")
            ids = [v.get("id", "") for v in vulns]
            maxsev = max((float(g.get("max_severity", "0") or 0) for g in (p.get("groups") or [])), default=0.0)
            # id → severity from the groups (max when an id spans several groups)
            id2sev = {}
            for g in (p.get("groups") or []):
                try: gs = float(g.get("max_severity", "0") or 0)
                except Exception: gs = 0.0
                for gid in (g.get("ids") or []):
                    if gid not in id2sev or gs > id2sev[gid]:
                        id2sev[gid] = gs
            id_fix = {}
            for v in vulns:
                vid = v.get("id", "")
                if vid not in adv_table:
                    adv_table[vid] = adv_entry(v)
                fx = advisory_fix(v, name, info.get("ecosystem", ""), info.get("version", ""))
                if fx and vid not in id_fix:
                    id_fix[vid] = fx
            fix = max_fix(list(id_fix.values()))
            if src not in root_of:
                root_of[src] = finding_root(src)
            # advisory ids not present for this (src, pkg) in the previous scan
            base_ids = baseline_findings.get(src, {}).get(name, []) if baseline_valid else []
            records.append({
                "src": src, "root": root_of[src], "pkg": name,
                "version": info.get("version", ""), "eco": info.get("ecosystem", ""),
                "ids": ids, "id_sev": id2sev, "maxsev": maxsev, "id_fix": id_fix, "fix": fix,
                "new_ids": [i for i in ids if i not in base_ids] if baseline_valid else [],
            })

# current union of ALL vulnerable findings (active AND acked), from the records
# — used both for the state file and the resolved-since diff.
cur_findings = {}
for rec in records:
    cur_findings.setdefault(rec["src"], {})[rec["pkg"]] = rec["ids"]

# --- acknowledgements (schema v2, advisory-scoped) -------------------------
# Read the ack store, tolerant of a v1-shaped store (arrays), which we treat as
# open-ended (cover-all). Build:
#   project_ack[src]      = ids-map {pkg:[ids]} | None   (None = cover-all)
#   package_ack[src][pkg] = ids-list [ids]      | None   (None = cover-all)
acks_raw = None
try:
    with open(os.environ.get("ACKS", "")) as f:
        acks_raw = json.load(f)
except Exception:
    acks_raw = None

project_ack, package_ack = {}, {}
if isinstance(acks_raw, dict):
    projs = acks_raw.get("projects")
    if isinstance(projs, dict):                       # v2: {src: {ids, since}}
        for src, ent in projs.items():
            project_ack[src] = (ent or {}).get("ids") if isinstance(ent, dict) else None
    elif isinstance(projs, list):                     # v1: [src, …] → cover-all
        for src in projs:
            project_ack[src] = None
    pkgs = acks_raw.get("packages")
    if isinstance(pkgs, dict):
        for src, sub in pkgs.items():
            m = {}
            if isinstance(sub, dict):                 # v2: {pkg: {ids, since}}
                for pkg, ent in sub.items():
                    m[pkg] = (ent or {}).get("ids") if isinstance(ent, dict) else None
            elif isinstance(sub, list):               # v1: [pkg, …] → cover-all
                for pkg in sub:
                    m[pkg] = None
            package_ack[src] = m

def id_suppressed(src, name, vid):
    # An advisory id is suppressed iff a project- or package-level ack covers it:
    # a None ids-set covers everything, otherwise the id must be listed.
    if src in project_ack:
        pj = project_ack[src]
        if pj is None or vid in ((pj.get(name) if isinstance(pj, dict) else None) or []):
            return True
    pk = package_ack.get(src, {})
    if name in pk:
        pl = pk[name]
        if pl is None or vid in pl:
            return True
    return False

def is_muted(src, name):
    # True when SOME ack (project or package) applies to this (src, pkg), whether
    # cover-all or advisory-scoped — used to flag a mute-piercing active fragment.
    return src in project_ack or name in package_ack.get(src, {})

# --- one-time backfill of open-ended (legacy) mutes ------------------------
# Grandfather any ack whose ids is null (open-ended) to the advisories seen in
# THIS scan, so genuinely new advisories pierce the mute on later runs. This run
# still treats the open-ended mute as cover-all (project_ack/package_ack already
# captured the None). Writes the ack store atomically, only when it changed.
def backfill_open_ended(a, cur, path):
    if not isinstance(a, dict) or not path:
        return
    changed = False
    projs = a.get("projects")
    if isinstance(projs, dict):
        for src, ent in projs.items():
            if isinstance(ent, dict) and ent.get("ids") is None and src in cur:
                ent["ids"] = cur[src]          # {pkg:[ids]} — matches state_proj
                changed = True
    pkgs = a.get("packages")
    if isinstance(pkgs, dict):
        for src, sub in pkgs.items():
            if not isinstance(sub, dict):
                continue
            for pkg, ent in sub.items():
                if isinstance(ent, dict) and ent.get("ids") is None \
                   and src in cur and pkg in cur[src]:
                    ent["ids"] = cur[src][pkg]  # [ids] — matches state_pkg
                    changed = True
    if changed:
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(a, f, indent=2)
        os.replace(tmp, path)

if not render:   # scan-only: --render never rewrites the ack store
    backfill_open_ended(acks_raw, cur_findings, os.environ.get("ACKS", ""))

# Severity: 0 / unknown is "no score" (the Go database publishes no CVSS), not
# LOW. Ranks for ordering: CRIT 5, HIGH 4, no score 3, MED 2, LOW 1 — every
# severity sort uses sev_key. Counts (critical = >= 9) stay on the raw score.
def _sev_num(score):
    try: return float(score)
    except Exception: return 0.0

def sev_rank(score):
    s = _sev_num(score)
    if s >= 9: return 5
    if s >= 7: return 4
    if s <= 0: return 3
    if s >= 4: return 2
    return 1

def sev_key(score):
    return (sev_rank(score), _sev_num(score))

def sev_bucket(score):
    s = _sev_num(score)
    if s <= 0: return ("na", "no score")
    if s >= 9: return ("crit", "CRIT")
    if s >= 7: return ("high", "HIGH")
    if s >= 4: return ("med",  "MED")
    return ("low", "LOW")

def sev_badge(score):
    s = _sev_num(score)
    if s <= 0:
        return '<span class="sev na">no score</span>'
    cls, lbl = sev_bucket(s)
    return f'<span class="sev {cls}">{lbl} {s:.1f}</span>'

# --- partition each vulnerable package into active / acknowledged fragments --
# A package's advisories split into UNCOVERED (active) and COVERED (acked) ids.
# Each non-empty side becomes a "fragment" row; a mixed package appears in BOTH
# sections. Per-fragment severity = max over its ids (id→severity from the
# osv-scanner groups, falling back to the package max). new_ids apply to the
# active fragment only; an active fragment of an otherwise-muted package is a
# "pierced" fragment (rendered with a muted badge; its button folds the new
# advisory into the mute).
active, acked = [], []
by_src = []   # [(src, root, [records])] — a src's records are contiguous
for rec in records:
    if not by_src or by_src[-1][0] != rec["src"]:
        by_src.append((rec["src"], rec["root"], []))
    by_src[-1][2].append(rec)
for src, root, recs in by_src:
    act_pkgs, ack_pkgs = [], []
    for rec in recs:
        name, ids = rec["pkg"], rec["ids"]
        def frag_sev(frag_ids, _m=rec["maxsev"], _s=rec["id_sev"]):
            return max((_s.get(i, _m) for i in frag_ids), default=0.0)
        fix, eco, version = rec["fix"], rec["eco"], rec["version"]
        adv = {"id_sev": rec["id_sev"], "maxsev": rec["maxsev"],
               "id_fix": rec.get("id_fix") or {}}
        covered   = [i for i in ids if id_suppressed(src, name, i)]
        uncovered = [i for i in ids if not id_suppressed(src, name, i)]
        muted = is_muted(src, name)
        if uncovered:
            act_pkgs.append({
                "name": name, "version": version, "eco": eco, "fix": fix,
                "sev": frag_sev(uncovered), "count": len(uncovered), "ids": uncovered,
                "new_ids": [i for i in uncovered if i in rec["new_ids"]],
                "muted": muted,                       # pierced a mute → muted badge
                "reack_project": src in project_ack,  # its ack form: project vs package
                **adv,
            })
        if covered:
            ack_pkgs.append({
                "name": name, "version": version, "eco": eco, "fix": fix,
                "sev": frag_sev(covered), "count": len(covered), "ids": covered,
                "new_ids": [],
                **adv,
            })
    # a project's maxsev is its top row's severity (rank first: a card of
    # "no score" + MED is headed "no score")
    if act_pkgs:
        act_pkgs.sort(key=lambda x: sev_key(x["sev"]), reverse=True)
        active.append({"src": src, "root": root, "pkgs": act_pkgs,
                       "maxsev": act_pkgs[0]["sev"]})
    if ack_pkgs:
        ack_pkgs.sort(key=lambda x: sev_key(x["sev"]), reverse=True)
        acked.append({"src": src, "root": root, "pkgs": ack_pkgs,
                      "maxsev": ack_pkgs[0]["sev"], "whole": src in project_ack})
active.sort(key=lambda x: sev_key(x["maxsev"]), reverse=True)
acked.sort(key=lambda x: sev_key(x["maxsev"]), reverse=True)

# A partially-muted package appears once per section (an active fragment AND
# an acked fragment for the same (src, pkg)) — same for a project whose
# packages split that way. Both would otherwise render the same DOM id twice;
# the active row/card wins the plain id, the acked twin gets suffix "-k".
active_srcs = {pr["src"] for pr in active}
active_pkg_keys = {(pr["src"], p["name"]) for pr in active for p in pr["pkgs"]}

# --- per-project-root Finder markers (drive folder-mark) -------------------
# aggregate active + acked findings per root: active wins the status, counts sum.
root_agg = {}   # root -> {"av": active_vulns, "ac": active_crit_pkgs, "kv": acked_vulns, "has_active": bool}
def _root_entry(root):
    return root_agg.setdefault(root, {"av": 0, "ac": 0, "kv": 0, "has_active": False})
for pr in active:
    root = pr["root"]
    if root in scan_targets and not probe:   # skip a root that IS a scan target
        continue
    e = _root_entry(root); e["has_active"] = True
    for p in pr["pkgs"]:
        e["av"] += p["count"]
        if p["sev"] >= 9: e["ac"] += 1
for pr in acked:
    root = pr["root"]
    if root in scan_targets and not probe:
        continue
    e = _root_entry(root)
    for p in pr["pkgs"]:
        e["kv"] += p["count"]

mark_active = sum(1 for e in root_agg.values() if e["has_active"])
mark_acked  = len(root_agg) - mark_active

# desired tsv for folder-mark sync: root<TAB>status<TAB>summary
mf = os.environ.get("MARKS", "")
if mf:
    lines = []
    for root, e in root_agg.items():
        if e["has_active"]:
            crit = f" ({e['ac']} critical)" if e["ac"] else ""
            lines.append(f"{root}\tactive\t{e['av']} active vulnerabilities{crit}")
        else:
            lines.append(f"{root}\tacked\t{e['kv']} acknowledged")
    with open(mf, "w") as f:
        if lines:
            f.write("\n".join(lines) + "\n")

def tally(projlist):
    vulns = sum(p["count"] for pr in projlist for p in pr["pkgs"])
    pkgs  = sum(len(pr["pkgs"]) for pr in projlist)
    crit  = sum(1 for pr in projlist for p in pr["pkgs"] if p["sev"] >= 9)
    return len(projlist), pkgs, vulns, crit
a_proj, a_pkg, a_vuln, a_crit = tally(active)
k_proj, k_pkg, k_vuln, k_crit = tally(acked)

# --- new / resolved since last scan (computed only when baseline is valid) --
# NEW = active finding keys (src, pkg, id) absent from the baseline union.
# RESOLVED = baseline union keys absent from the current union.
# --render: NEW from the fragments (the saved new_ids, filtered to the now
# uncovered ids), RESOLVED as the scan counted it.
if render:
    new_vulns = sum(len(p["new_ids"]) for pr in active for p in pr["pkgs"])
    resolved_vulns = saved_resolved
else:
    new_vulns = sum(len(p["new_ids"]) for pr in active for p in pr["pkgs"]) if baseline_valid else 0
    resolved_vulns = 0
if not render and baseline_valid:
    cur_keys = {(s, n, i) for s, pk in cur_findings.items() for n, ids in pk.items() for i in ids}
    resolved_vulns = sum(1 for s, pk in baseline_findings.items() for n, ids in pk.items()
                         for i in ids if (s, n, i) not in cur_keys)

# hand the active/acked counts back to the shell (notification + log)
cf = os.environ.get("COUNTS", "")
if cf:
    with open(cf, "w") as f:
        f.write(f"ACTIVE_PROJECTS={a_proj}\nACTIVE_PKGS={a_pkg}\nACTIVE_VULNS={a_vuln}\nACTIVE_CRIT={a_crit}\n")
        f.write(f"ACKED_PROJECTS={k_proj}\nACKED_PKGS={k_pkg}\nACKED_VULNS={k_vuln}\nACKED_CRIT={k_crit}\n")
        f.write(f"NEW_VULNS={new_vulns}\nRESOLVED_VULNS={resolved_vulns}\n")
        f.write(f"MARK_ACTIVE={mark_active}\nMARK_ACKED={mark_acked}\n")
        if render:
            f.write(f"SCAN_STAMP={shlex.quote(stamp)}\n")

# --- last-scan state file (baseline for a future diff task) ----------------
# findings = union of ALL vulnerable findings (active AND acknowledged),
# collected straight from the raw scan results so ack state doesn't matter.
# render = the records above, what --render rebuilds the report from.
# Written by a scan only (STATE is empty under --probe; --render reads it).
sf = os.environ.get("STATE", "")
if sf and not render:
    state = {
        "schema": 1,
        "stamp": stamp,
        "target": target,
        "counts": {
            "active": {"projects": a_proj, "pkgs": a_pkg, "vulns": a_vuln, "crit": a_crit},
            "acked":  {"projects": k_proj, "pkgs": k_pkg, "vulns": k_vuln, "crit": k_crit},
            "new_vulns": new_vulns, "resolved_vulns": resolved_vulns,
        },
        "findings": cur_findings,
        "render": {"schema": 1, "scan_targets": scan_targets, "packages": records,
                   "advisories": adv_table},
    }
    os.makedirs(os.path.dirname(sf) or ".", exist_ok=True)
    tmp = sf + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, indent=2)
    os.replace(tmp, sf)

def short(src):
    return html.escape(src.replace(os.path.expanduser("~/Projects/"), ""))

# card head: the lockfile's folder name, big; the path (short) beneath it, small.
# A generic folder name gets its parent ("reconnect-ident / go"); when one folder
# holds several lockfiles, each head carries a small package-manager tag.
GENERIC_DIRS = {"go", "app", "src", "server", "client", "backend", "frontend", "web", "api"}
LOCK_TAGS = {"package-lock.json": "npm", "npm-shrinkwrap.json": "npm", "pnpm-lock.yaml": "pnpm",
             "yarn.lock": "yarn", "bun.lock": "bun", "bun.lockb": "bun", "Cargo.lock": "cargo",
             "go.mod": "go", "go.sum": "go", "Gemfile.lock": "bundler", "poetry.lock": "poetry",
             "Pipfile.lock": "pipenv", "uv.lock": "uv", "requirements.txt": "pip",
             "composer.lock": "composer", "mix.lock": "mix"}
lock_dirs = {}   # folder -> number of distinct lockfiles in this report (filled before rendering)

def proj_name(src):
    d = os.path.dirname(src)
    name = os.path.basename(d) or src
    if name.lower() in GENERIC_DIRS and os.path.basename(os.path.dirname(d)):
        name = os.path.basename(os.path.dirname(d)) + " / " + name
    tag = ""
    if lock_dirs.get(d, 0) > 1:
        f = os.path.basename(src)
        tag = f'<span class="lt">{html.escape(LOCK_TAGS.get(f, f))}</span>'
    return html.escape(name) + tag

def cp_btn(cmd, label):
    return (f'<button class="cp" type="button" data-cmd="{html.escape(cmd)}" '
            f'title="Copy this command, then paste it in your terminal">{html.escape(label)}</button>')

def app_link(action, params, label, title, extra=""):
    # params: ordered [(name, value)]; values percent-encoded with no safe chars
    q = "&".join(k + "=" + urllib.parse.quote(v, safe="") for k, v in params)
    href = "hiveguard://" + action + "?v=1&" + q
    # target=_blank: a hiveguard:// link followed in the report's own tab makes
    # Opera/Chromium close that tab after handing the URL to the app; a throwaway
    # tab is closed instead and the report stays open.
    return (f'<a class="act-link{extra}" href="{html.escape(href)}" '
            f'title="{title}" target="_blank" rel="noopener">{html.escape(label)}</a>')

def cp_alt(cmd):
    # the terminal command, tucked behind a small secondary copy button
    c = html.escape(cmd)
    return (f'<button class="cp cp-alt" type="button" data-cmd="{c}" '
            f'title="Copy the terminal command instead" aria-label="Copy command: {c}">copy</button>')

def desc_of(vid):
    # one-line description: the summary, else the first sentence of the details
    # (to the first ". ", ".\n" or newline, at most 160 characters)
    a = (adv_table or {}).get(vid) or {}
    s = (a.get("summary") or "").strip()
    if s:
        return s
    d = (a.get("details") or "").strip()
    if d:
        cut = len(d)
        for sep, keep in ((". ", 1), (".\n", 1), ("\n", 0)):
            k = d.find(sep)
            if k != -1:
                cut = min(cut, k + keep)
        return d[:cut][:160].rstrip()
    return "no description"

def adv_cells(p, fid, new_ids):
    # new layout: the Advisory cell (lead id + description toggle) and the
    # hidden list row with one <li> per id, both in lead order
    order = sorted(p["ids"], key=lambda i: sev_key(p["id_sev"].get(i, p["maxsev"])), reverse=True)
    def link(i):
        return (f'<a class="{"new" if i in new_ids else ""}" '
                f'href="https://osv.dev/{html.escape(i)}" target="_blank" rel="noopener">{html.escape(i)}</a>')
    lead = order[0]
    desc = html.escape(desc_of(lead))
    more = f'<span class="more">+{len(order)-1} more</span>' if len(order) > 1 else ""
    cell = (f'<td class="ids">{link(lead)} <button class="advt" type="button" aria-expanded="false" '
            f'aria-controls="a-{fid}" title="{desc}"><span class="advs">{desc}</span>{more}</button></td>')
    lis = []
    for i in order:
        a = adv_table.get(i) or {}
        aliases = "".join(f'<span class="alias">{html.escape(x)}</span>'
                          for x in (a.get("aliases") or []) if x.startswith("CVE-"))
        nb = '<span class="newbadge">NEW</span>' if i in new_ids else ""
        fx = p["id_fix"].get(i)
        afix = f'<span class="afix">fixed in {html.escape(fx)}</span>' if fx else ""
        lis.append(f'<li>{link(i)}{aliases}{sev_badge(p["id_sev"].get(i, p["maxsev"]))}{nb}'
                   f'<span class="sum">{html.escape(desc_of(i))}</span>{afix}'
                   f'<details class="advd"><summary>details</summary>'
                   f'<pre class="advtext" data-adv="{html.escape(i)}"></pre></details></li>')
    row = (f'<tr class="adv" id="a-{fid}" hidden><td colspan="6"><ul class="advl">'
           f'{"".join(lis)}</ul></td></tr>')
    return cell, row

def pkg_row(p, src, section):
    active_sec = section == "active"
    pierced = active_sec and p.get("muted")   # active fragment of a muted package
    # NEW badge + accented links apply to active rows only (matches the tile count)
    new_ids = set(p.get("new_ids") or []) if active_sec else set()
    idlinks = " ".join(
        f'<a class="{"new" if i in new_ids else ""}" '
        f'href="https://osv.dev/{html.escape(i)}" target="_blank" rel="noopener">{html.escape(i)}</a>'
        for i in p["ids"][:4])
    more = f' <span class="more">+{len(p["ids"])-4}</span>' if len(p["ids"]) > 4 else ""
    badge = ('<span class="mutedbadge">muted</span>' if pierced else "") \
          + (f'<span class="newbadge">NEW +{len(new_ids)}</span>' if new_ids else "")
    fix = html.escape(p["fix"]) if p["fix"] else '<span class="none">—</span>'
    if section == "acked":
        cmd, label = "hiveguard ack --remove " + shlex.quote(src) + " " + shlex.quote(p["name"]), "unmute"
    elif pierced:
        # the same ack again folds the pierced advisory into the existing mute;
        # use the project form when the coverage came from a whole-project mute.
        if p.get("reack_project"):
            cmd, label = "hiveguard ack " + shlex.quote(src), "mute"
        else:
            cmd, label = "hiveguard ack " + shlex.quote(src) + " " + shlex.quote(p["name"]), "mute"
    else:
        cmd, label = "hiveguard ack " + shlex.quote(src) + " " + shlex.quote(p["name"]), "mute"
    if links_on and active_sec:
        if pierced:
            title = ("A new advisory appeared in a package you had muted. "
                     "Mark it as known too (asks for confirmation).")
            if p.get("reack_project"):
                link = app_link("ack-project", [("src", src)], "mark as known", title)
            else:
                link = app_link("ack", [("src", src), ("pkg", p["name"])], "mark as known", title)
        else:
            link = app_link("ack", [("src", src), ("pkg", p["name"])], "mark as known",
                            "Mark this finding as known via the HiveGuard app (asks for confirmation)")
        btn = f'<span class="actg">{link}{cp_alt(cmd)}</span>'
    else:
        btn = cp_btn(cmd, label)
    # section 2.7 report anchor: f-<h12(src\0pkg)>, same formula as the run
    # file's "anchor". When this (src, pkg) also has an active-section row
    # (partial mute), the active row wins the plain id and this acked twin
    # gets suffix "-k" so the two <tr> elements don't share a DOM id.
    # The list row a-<fid> follows the same rule.
    fid = "f-" + h12(src + "\0" + p["name"])
    if section == "acked" and (src, p["name"]) in active_pkg_keys:
        fid += "-k"
    if adv_table is None:   # legacy layout (state saved without advisories)
        idcell, advrow = f'<td class="ids">{idlinks}{more}</td>', ""
    else:
        idcell, advrow = adv_cells(p, fid, new_ids)
    return (f'<tr id="{fid}"><td class="pk">{html.escape(p["name"])}<span class="eco">{html.escape(p["eco"])}</span></td>'
            f'<td class="mono">{html.escape(p["version"])}</td>'
            f'<td>{sev_badge(p["sev"])}{badge}</td>'
            f'<td class="mono fix">{fix}</td>'
            f'{idcell}'
            f'<td class="act">{btn}</td></tr>{advrow}')

def proj_card(pr, muted):
    rows = "".join(pkg_row(p, pr["src"], "acked" if muted else "active") for p in pr["pkgs"])
    if muted:
        head_btn = cp_btn("hiveguard ack --remove " + shlex.quote(pr["src"]), "unmute all")
        whole = '<span class="whole">whole project</span>' if pr.get("whole") else ''
        last = "Unmute"
    else:
        if links_on:
            links = app_link("ack-project", [("src", pr["src"])], "mark project as known",
                             "Mark every finding of this project as known via the HiveGuard app "
                             "(asks for confirmation)")
            root = pr["root"]
            if strict_on and root in root_agg:
                for dur, words in (("1h", "1 hour"), ("2h", "2 hours")):
                    links += app_link("pause", [("root", root), ("for", dur)],
                                      "pause strict " + dur[:-1] + " h",
                                      "Pause strict mode for this project for " + words +
                                      " via the HiveGuard app (asks for confirmation)", " pause")
            head_btn = f'<span class="actg">{links}{cp_alt("hiveguard ack " + shlex.quote(pr["src"]))}</span>'
        else:
            head_btn = cp_btn("hiveguard ack " + shlex.quote(pr["src"]), "mute project")
        whole = ''
        last = "Mute"
    sel = ('<input type="checkbox" class="selp" '
           f'data-ack="{html.escape("hiveguard ack " + shlex.quote(pr["src"]))}" '
           f'aria-label="Select {short(pr["src"])} to mute">') if not muted else ''
    # section 2.7 report anchor: p-<h12(src)>. Same "-k" rule as pkg_row above,
    # for a project that appears in both sections (some packages active, some
    # fully covered by an ack).
    pid = "p-" + h12(pr["src"])
    if muted and pr["src"] in active_srcs:
        pid += "-k"
    return (f'<details id="{pid}" class="proj{" acked" if muted else ""}"><summary>'
            f'<span class="chev">▶</span>{sel}'
            f'{sev_badge(pr["maxsev"])}'
            f'<span class="pname"><span class="pn">{proj_name(pr["src"])}</span><span class="pp">{short(pr["src"])}</span></span>{whole}'
            f'<span class="cnt">{len(pr["pkgs"])} packages</span>{head_btn}</summary>'
            f'<div class="tblwrap"><table><thead><tr><th>Package</th><th>Version</th>'
            f'<th>Max severity</th><th>Fixed in</th><th>{"IDs" if adv_table is None else "Advisory"}</th><th class="acth">{last}</th></tr></thead>'
            f'<tbody>{rows}</tbody></table></div></details>')

for _s in {pr["src"] for pr in active + acked}:
    lock_dirs[os.path.dirname(_s)] = lock_dirs.get(os.path.dirname(_s), 0) + 1

if active:
