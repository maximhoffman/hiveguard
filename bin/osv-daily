# atomic: a browser reload during the write never sees a half page. --render
# keeps the report's modification time — the scan's (or, when the report is
# missing, the state file's, written at scan end) — so --if-due and the
# open-or-rescan gate never take an ack for a fresh scan.
out = os.environ["OUT"]
if render:
    keep = os.stat(out) if os.path.exists(out) else os.stat(os.environ["STATE"])
tmp = out + ".tmp"
with open(tmp, "w") as f:
    f.write(page)
os.replace(tmp, out)
if render:
    os.utime(out, (keep.st_atime, keep.st_mtime))

# --- run outcome file (scan only: STATE is empty under --probe; never on --render)
# `new` = this run's new advisory ids per active package fragment; `unseen` =
# `new` plus the previous run's unseen ids still present in this scan, carried
# over only while the report has not been opened since that previous run. Acks
# are NOT applied here — `hiveguard status` applies them live.
if sf and not render:
    run_path = os.environ.get("RUN", "")
    all_keys = {(s, n, i) for s, pk in cur_findings.items() for n, ids in pk.items() for i in ids}
    this_run_new = []
    for pr in active:
        for p in pr["pkgs"]:
            if not p["new_ids"]:
                continue
            this_run_new.append({
                "src": pr["src"], "root": finding_root(pr["src"]), "pkg": p["name"],
                "version": p["version"], "eco": p["eco"], "sev": p["sev"], "fix": p["fix"] or "",
                "ids": list(p["new_ids"]),
                "anchor": "f-" + h12(pr["src"] + "\0" + p["name"]),
                "project_anchor": "p-" + h12(pr["src"]),
            })
    prev_run = None
    try:
        with open(run_path) as f:
            prev_run = json.load(f)
    except Exception:
        prev_run = None
    if not isinstance(prev_run, dict):
        prev_run = None
    try:
        with open(os.environ.get("OPENED", "")) as f:
            opened = int(f.read().strip())
    except Exception:
        opened = 0
    try:
        prev_finished = int(prev_run.get("finished_epoch", 0) or 0) if prev_run else 0
    except Exception:
        prev_finished = 0
    carry = (prev_run.get("unseen") or []) if prev_run and opened < prev_finished else []
    merged = {}
    for e in carry:
        if not isinstance(e, dict):
            continue
        ids = [i for i in (e.get("ids") or []) if (e.get("src"), e.get("pkg"), i) in all_keys]
        if ids:
            merged[(e.get("src"), e.get("pkg"))] = {**e, "ids": ids}
    for n in this_run_new:                    # this run's metadata wins, ids unioned
        k = (n["src"], n["pkg"]); m = merged.get(k)
        merged[k] = n if m is None else {**n, "ids": sorted(set(m["ids"]) | set(n["ids"]))}
    def order(e):
        try: sv = float(e.get("sev") or 0)
        except Exception: sv = 0.0
        return (-sv, e.get("src") or "", e.get("pkg") or "")
    unseen = sorted(merged.values(), key=order)
    this_run_new.sort(key=order)
    # every active package fragment (the report's Active rows) — what the app
    # validates report links against; ids = the uncovered ids at scan time
    active_entries = sorted(({
        "src": pr["src"], "root": finding_root(pr["src"]), "pkg": p["name"],
        "version": p["version"], "eco": p["eco"], "sev": p["sev"], "fix": p["fix"] or "",
        "ids": list(p["ids"]),
        "anchor": "f-" + h12(pr["src"] + "\0" + p["name"]),
        "project_anchor": "p-" + h12(pr["src"]),
    } for pr in active for p in pr["pkgs"]), key=order)
    roots = {r: {"status": "active" if e["has_active"] else "acked",
                 "active_vulns": e["av"], "crit_pkgs": e["ac"], "acked_vulns": e["kv"]}
             for r, e in root_agg.items()}
    run_doc = {
        "schema": 1, "ok": True, "rc": int(os.environ.get("SCAN_RC", "0") or 0), "error": None,
        "started_epoch": int(os.environ.get("STARTED", "0") or 0),
        "finished_epoch": int(time.time()),
        "stamp": ig("STAMP"), "target": ig("TARGET"),
        "counts": state["counts"], "roots": roots,
        "new": this_run_new, "unseen": unseen, "active": active_entries,
    }
    if run_path:
        os.makedirs(os.path.dirname(run_path) or ".", exist_ok=True)
        tmp = run_path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(run_doc, f, indent=2)
        os.replace(tmp, run_path)
PYEOF
}

if [ "$open_flag" = 1 ]; then
  if [ -f "$REPORT" ]; then
    print_last_summary   # "I missed the notification" recovery, before opening
    report_is_today || echo "Note: report is from $(stat -f %Sm -t %Y-%m-%d "$REPORT" 2>/dev/null) and may be stale." >&2
    open_report
    exit 0
  fi
  echo "No report yet at $REPORT — run osv-daily to create one." >&2
  exit 1
elif [ "$render_flag" = 1 ]; then
  render_report; exit $?   # never scans, checks osv-scanner or pulls bumblebee
elif [ "$rescan_flag" = 1 ]; then
  :   # always scan, never prompt
elif [ "$probe_flag" = 1 ]; then
  :   # background probe: always scan, never prompt, never open
elif [ "$ifdue_flag" = 1 ]; then
  if report_is_today; then exit 0; fi   # fresh → nothing to do, silently
  # else: scan silently
elif [ -t 0 ] && [ -t 1 ]; then
  if report_is_today; then
    print_last_summary   # show the recovered summary before opening + prompting
    open_report
    printf 'Rescan now? [y/N] ' >&2
    read -r ans || ans=""
    case "$ans" in y|Y) : ;; *) exit 0 ;; esac
  fi
  # no today's report → scan immediately, no prompt
fi
# no flag + non-interactive (launchd, pipe) → fall through and scan silently

ACKS="${HIVEGUARD_ACKS:-$HOME/.hiveguard/osv-acks.json}"
JSON="$(mktemp)"; COUNTS="$(mktemp)"; MARKS="$(mktemp)"; ERRFILE="$(mktemp)"
# The scan pid file is removed only when it still names THIS run, so an early
# exit can never delete the pid file of another, still-running scan.
trap 'rm -f "$JSON" "$COUNTS" "$MARKS" "$ERRFILE"
      [ "$probe_flag" = 1 ] || { [ "$(cat "$SCAN_PID" 2>/dev/null)" = "$$" ] && rm -f "$SCAN_PID"; } || true' EXIT
LOGDIR="$HOME/.hiveguard"; mkdir -p "$LOGDIR" "$(dirname "$REPORT")"
STAMP="$(date '+%Y-%m-%d %H:%M')"

command -v osv-scanner >/dev/null || { echo "osv-scanner not found"; exit 1; }

# bumblebee layer: keep the catalog fresh (install-gate)
if [ -d "$HOME/bumblebee-src/.git" ]; then
  git -C "$HOME/bumblebee-src" pull --quiet 2>/dev/null || true
fi

# We are about to scan. With no folder given, fall back to the folders
# configured for the daily schedule — the launchd plist is the single source
# of truth (same extraction as daily-schedule's plist_folders; paths may
# contain spaces, so read line by line).
if [ "${#TARGETS[@]}" -eq 0 ]; then
  SCHED_PLIST="${HIVEGUARD_SCHED_PLIST:-$HOME/Library/LaunchAgents/com.hiveguard.osv-daily.plist}"
  if [ -f "$SCHED_PLIST" ]; then
    while IFS= read -r _f; do
      [ -n "$_f" ] && TARGETS+=("$_f")
    done < <(awk '
      /<string>daily<\/string>/    { grab=1; next }
      /<\/array>/                  { grab=0 }
      grab && /<string>--if-due<\/string>/ { grab=0; next }
      grab && /<string>.*<\/string>/ {
        s=$0; sub(/.*<string>/,"",s); sub(/<\/string>.*/,"",s); print s
      }
    ' "$SCHED_PLIST")
  fi
  if [ "${#TARGETS[@]}" -gt 0 ]; then
    echo "scanning scheduled folders: ${TARGETS[*]}" >&2
  fi
fi

# Still nothing → a folder is required (no whole-home default).
if [ "${#TARGETS[@]}" -eq 0 ]; then
  echo "osv-daily: no folder to scan." >&2
  echo "  Pass one or more folders:   hiveguard daily ~/Projects" >&2
  echo "  or set up the daily scan:   hiveguard schedule on --hour 10 ~/Projects" >&2
  exit 2
fi

# Canonical (realpath'd) scan targets — used both to bound the per-finding root
# walk (in python) and as folder-mark's --target set. Newline-joined for python.
CANON_TARGETS=()
for _t in "${TARGETS[@]}"; do CANON_TARGETS+=("$(canon_path "$_t")"); done
SCAN_TARGETS=""
[ "${#CANON_TARGETS[@]}" -gt 0 ] && SCAN_TARGETS="$(printf '%s\n' "${CANON_TARGETS[@]}")"

# osv-scanner (verified on 2.6.0) ignores the documented bare-dirname form of
# --experimental-exclude entirely, and matches g:/r: patterns against the
# ABSOLUTE path as given (symlinks unresolved) minus the leading `/`. So an
# unanchored pattern would also drop a target that merely LIVES under such a
# name (a worktree in .claude/worktrees, a project in ~/go/src). Anchor one
# regex per target instead (RE2 \Q…\E quotes the path), and hand osv-scanner
# the same absolute, unresolved paths the regexes were built from.
_alt() { printf '%s|' "$@" | sed 's/\./\\./g; s/|$//'; }
EXCLUDE_ARGS=()
OSV_TARGETS=()
for _t in "${TARGETS[@]}"; do
  _a="$(cd "$_t" 2>/dev/null && pwd)" || _a="$_t"
  OSV_TARGETS+=("$_a")
  EXCLUDE_ARGS+=(--experimental-exclude "r:^\\Q${_a#/}\\E/(.*/)?($(_alt "${EXCLUDE_ANY[@]}"))(/|\$)")
done
EXCLUDE_ARGS+=(--experimental-exclude "r:^\\Q${HOME#/}\\E/($(_alt "${EXCLUDE_HOME[@]}"))(/|\$)")

# Scan in progress: a non-probe run records its pid right before the scanner
# starts (the EXIT trap removes it) and notes the start time for osv-run.json.
STARTED="$(date +%s)"
if [ "$probe_flag" = 0 ]; then
  mkdir -p "$(dirname "$SCAN_PID")" 2>/dev/null || true
  printf '%s' "$$" > "$SCAN_PID" 2>/dev/null || true
fi

# one scan over all target folders (with the default exclusions applied).
# In an interactive terminal (stdout AND stderr are both TTYs) show a single,
# self-overwriting progress line on stderr while osv-scanner walks the tree, and
# surface a real scanner failure instead of the silent 0 it would otherwise
# become. Non-interactive runs (launchd, pipes, any redirect) stay silent, but
# their stderr is captured too, so a failure can be recorded (see below).
SHOW_PROGRESS=0
{ [ -t 1 ] && [ -t 2 ]; } && SHOW_PROGRESS=1
[ "$probe_flag" = 1 ] && SHOW_PROGRESS=0   # a background probe animates nothing
scan_rc=0
if [ "$SHOW_PROGRESS" = 1 ]; then
  # Background the scan so we can animate while it runs: stdout->JSON,
  # stderr->ERRFILE (osv-scanner prints its "Scanned … found N packages" walk
  # progress on stderr). $SECONDS resets to give whole-second elapsed cheaply.
  SECONDS=0
  osv-scanner scan source --recursive --format json "${EXCLUDE_ARGS[@]}" "${OSV_TARGETS[@]}" > "$JSON" 2>"$ERRFILE" &
  _scan_pid=$!
  _spin='-\|/'; _i=0
  while kill -0 "$_scan_pid" 2>/dev/null; do
    _c="${_spin:$((_i % 4)):1}"; _i=$((_i + 1))
    # Re-parse the stderr log each tick (BSD awk — no gawk match() array):
    #   N = count of "Scanned " lines, M = sum of the "found N packages" numbers.
    _mf="$(awk '/^Scanned /{n++} /found [0-9]+ package/{l=$0; sub(/.*found /,"",l); sub(/ package.*/,"",l); p+=l+0} END{printf "%d %d", n, p}' "$ERRFILE" 2>/dev/null)"
    _n="${_mf%% *}"; _m="${_mf##* }"
    if [ -n "$_n" ] && [ "$_n" -gt 0 ] 2>/dev/null; then
      printf '\r\033[K%s scanning %s … %s manifests · %s packages (%ss)' \
        "$_c" "$TARGET_STR" "$_n" "$_m" "$SECONDS" >&2
    else
      # stderr format didn't match (yet / at all) → degrade, never print garbage
      printf '\r\033[K%s scanning %s … (%ss)' "$_c" "$TARGET_STR" "$SECONDS" >&2
    fi
    sleep 0.2
  done
  wait "$_scan_pid" || scan_rc=$?
  printf '\r\033[K' >&2   # clear the line — net zero extra lines on a clean run
  # Surface a genuine failure (exit >1, or no JSON produced) rather than the
  # silent 0 the non-interactive path yields. Then fall through to the shared
  # empty-JSON fallback: report + state still get written, osv-daily still 0.
  if [ "$scan_rc" -gt 1 ] || [ ! -s "$JSON" ]; then
    echo "⚠ osv-scanner exited with code $scan_rc — previous report and state kept. Last output:" >&2
    grep -v '^Scanned ' "$ERRFILE" 2>/dev/null | tail -5 >&2 || true
  fi
else
  osv-scanner scan source --recursive --format json "${EXCLUDE_ARGS[@]}" "${OSV_TARGETS[@]}" > "$JSON" 2>"$ERRFILE" || scan_rc=$?
fi
# Did the scanner actually produce results? osv-scanner exits 1 when it FOUND
# vulnerabilities (not an error) and >1 on a real failure (e.g. 128 = no package
# sources). Judged BEFORE the empty-JSON fallback below, which deliberately turns
# a failure into a "0 results" report — coverage must not record that as a scan.
SCAN_OK=0
{ [ -s "$JSON" ] && { [ "$scan_rc" = 0 ] || [ "$scan_rc" = 1 ]; }; } && SCAN_OK=1

# Failed scan (non-probe): record it in osv-run.json and keep everything else —
# a "0 results" report would overwrite the diff baseline and clear the markers,
# so the next good scan would report every finding as new. No report, state,
# markers, coverage or notification; exit 0 so launchd sees no crash loop.
if [ "$probe_flag" = 0 ] && [ "$SCAN_OK" = 0 ]; then
  _first_err="$(RUN="$RUN" ERRFILE="$ERRFILE" SCAN_RC="$scan_rc" STARTED="$STARTED" \
    STAMP="$STAMP" TARGET="$TARGET_STR" python3 <<'PYEOF' 2>/dev/null
import json, os, time
run = os.environ["RUN"]
try:
    with open(os.environ["ERRFILE"], errors="replace") as f:
        lines = [l.rstrip("\n") for l in f]
except Exception:
    lines = []
lines = [l for l in lines if l.strip() and not l.startswith("Scanned ")][-5:]
prev = None
try:
    with open(run) as f:
        prev = json.load(f)
except Exception:
    prev = None
unseen = (prev.get("unseen") if isinstance(prev, dict) else None) or []
doc = {
    "schema": 1, "ok": False, "rc": int(os.environ["SCAN_RC"]),
    "error": "\n".join(lines) if lines else None,
    "started_epoch": int(os.environ["STARTED"]), "finished_epoch": int(time.time()),
    "stamp": os.environ["STAMP"], "target": os.environ["TARGET"],
    "counts": None, "roots": None, "new": [], "unseen": unseen,
    "active": (prev.get("active") if isinstance(prev, dict) else None) or [],
}
os.makedirs(os.path.dirname(run) or ".", exist_ok=True)
tmp = run + ".tmp"
with open(tmp, "w") as f:
    json.dump(doc, f, indent=2)
os.replace(tmp, run)
print(lines[0] if lines else "no output")
PYEOF
  )" || true
  [ -n "$_first_err" ] || _first_err="no output"
  echo "[$STAMP] FAILED rc=$scan_rc ($_first_err)" >> "$LOGDIR/osv-daily.log"
  echo "✖ scan failed (rc=$scan_rc) — previous report and state kept"
  exit 0
fi
[ -s "$JSON" ] || { echo '{"results":[]}' > "$JSON"; }

# A probe must leave the daily baseline alone: with STATE empty python neither
# reads a baseline (so nothing is reported "new") nor writes the state file.
[ "$probe_flag" = 1 ] && STATE=""

# compact HTML report. Python owns the counts because it also applies the
# acknowledgement filter, then writes the active/acked tallies to $COUNTS.
# APP_RUNNING / STRICT_ON gate the report's action links (see the header).
STRICT_ON=0; [ "$(config_get strict 0)" = 1 ] && STRICT_ON=1
APP_RUNNING=0; app_running && APP_RUNNING=1
APP_RUNNING="$APP_RUNNING" STRICT_ON="$STRICT_ON" JSON="$JSON" OUT="$REPORT" STAMP="$STAMP" TARGET="$TARGET_STR" ACKS="$ACKS" COUNTS="$COUNTS" STATE="$STATE" MARKS="$MARKS" SCAN_TARGETS="$SCAN_TARGETS" PROBE="$probe_flag" RUN="$RUN" OPENED="$OPENED" STARTED="$STARTED" SCAN_RC="$scan_rc" report_python

# active/acked counts computed by python (notification + log use the ACTIVE ones)
ACTIVE_PROJECTS=0; ACTIVE_PKGS=0; ACTIVE_VULNS=0; ACTIVE_CRIT=0
ACKED_PROJECTS=0; ACKED_PKGS=0; ACKED_VULNS=0; ACKED_CRIT=0
NEW_VULNS=0; RESOLVED_VULNS=0
MARK_ACTIVE=0; MARK_ACKED=0
[ -f "$COUNTS" ] && . "$COUNTS"

# Drive Finder folder markers from this scan. Fully best-effort: it must never
# fail the scan, the report, or the notification. (Only reached on a real scan —
# the --open path returns earlier.)
if [ "${#CANON_TARGETS[@]}" -gt 0 ]; then
  _mark_args=()
  for _t in "${CANON_TARGETS[@]}"; do _mark_args+=(--target "$_t"); done
  "$(dirname "$0")/folder-mark" sync "${_mark_args[@]}" < "$MARKS" 2>/dev/null || true
fi

# Scan coverage: one row per scanned folder, `folder<TAB>epoch`, upserted only
# when the scanner really ran (SCAN_OK). Strict mode reads this to tell a
# known-clean project (scanned recently, no marker row) from a never-scanned one.
# Rows for folders this run didn't scan are preserved; each write is atomic.
if [ "$SCAN_OK" = 1 ] && [ "${#CANON_TARGETS[@]}" -gt 0 ]; then
  mkdir -p "$(dirname "$COVERAGE")"
  _cov_now="$(date +%s)"
  for _t in "${CANON_TARGETS[@]}"; do
    _cov_tmp="$(mktemp)"
    [ -f "$COVERAGE" ] && awk -F'\t' -v r="$_t" '$1!=r' "$COVERAGE" > "$_cov_tmp" || true
    printf '%s\t%s\n' "$_t" "$_cov_now" >> "$_cov_tmp"
    mv "$_cov_tmp" "$COVERAGE"
  done
fi

# "· N new" suffix (notification + done-line) and " new=N" (log), only when > 0
new_suffix=""; new_log=""
if [ "${NEW_VULNS:-0}" -gt 0 ]; then new_suffix=" · $NEW_VULNS new"; new_log=" new=$NEW_VULNS"; fi

# marker summary for the log: R=active roots (red tag), Y=acked roots (yellow)
mark_log=" markers=R${MARK_ACTIVE:-0},Y${MARK_ACKED:-0}"

# a probe's log line is the normal one prefixed with "probe " (same log file)
log_kind=""; [ "$probe_flag" = 1 ] && log_kind="probe "

echo "[$STAMP] ${log_kind}projects=$ACTIVE_PROJECTS pkgs=$ACTIVE_PKGS vulns=$ACTIVE_VULNS crit=$ACTIVE_CRIT$new_log (acked: vulns=$ACKED_VULNS pkgs=$ACKED_PKGS)$mark_log → $REPORT" >> "$LOGDIR/osv-daily.log"

# notification only on ACTIVE (non-acknowledged) findings — and only when the
# menu bar app is not running (it owns notifications while its pid is live; a
# stale pid after a crash fails kill -0, so we fall back to notifying).
if [ "${ACTIVE_VULNS:-0}" -gt 0 ] && ! app_running && command -v terminal-notifier >/dev/null; then
  terminal-notifier -title "osv-daily: vulnerabilities found" \
    -message "$ACTIVE_PROJECTS project(s), $ACTIVE_PKGS package(s), $ACTIVE_VULNS total ($ACTIVE_CRIT critical)$new_suffix" \
    -open "file://$REPORT" -sender com.apple.Terminal 2>/dev/null || true
fi
echo "✅ done: $ACTIVE_VULNS active vulnerabilities across $ACTIVE_PROJECTS projects ($ACKED_VULNS acknowledged)$new_suffix → $REPORT"
