links_css = ("\n.actg{display:inline-flex;align-items:center;gap:6px;flex:none}"
             "\n.act-link{font-family:var(--mono);font-size:11px;color:var(--accent);background:var(--surface);border:1px solid var(--accent);border-radius:6px;padding:3px 8px;text-decoration:none;white-space:nowrap}"
