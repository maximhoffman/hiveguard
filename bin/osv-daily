#!/usr/bin/env bash
# osv-daily — daily vulnerability scan of all your projects (run by launchd).
# One scan -> JSON -> compact HTML report + macOS notification on findings.
# Also refreshes the bumblebee threat catalog so the install-gate stays current.
#
#   osv-daily              # interactive: open today's report, else scan
#   osv-daily <path>...    # same, scanning one or more given folders
#   osv-daily --open       # just open the last report (never scans)
#   osv-daily --rescan     # force a fresh scan now (never prompts)
#   osv-daily --if-due     # scan only if today's report is missing/stale
#   osv-daily -h|--help    # show this help
#
# Default target: with no path given, the whole home folder ($HOME) is scanned,
# with a fixed set of heavyweight/system directories excluded (Library, Caches,
# node_modules, .git, .cargo, go, …) so the sweep stays fast and quiet. Pass one
# or more explicit folders to scan those instead.
#
# Open-or-rescan: with no flag on an interactive terminal, if today's report
# already exists it opens and asks whether to rescan; otherwise it scans.
# Non-interactive runs (launchd, pipes) always scan silently.
#
# Acknowledgements: projects/packages muted via `hiveguard ack` (stored in
# ~/.hiveguard/osv-acks.json) are excluded from the totals and the notification,
# and shown in a collapsed "Acknowledged" section instead.
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# --- argument parsing ------------------------------------------------------
print_header() {
  # print this file's top comment block (what --help shows)
  awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"
}
usage_err() {
  echo "usage: osv-daily [--open | --rescan | --if-due] [path...]" >&2
  exit 2
}

open_flag=0; rescan_flag=0; ifdue_flag=0; TARGETS=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) print_header; exit 0 ;;
    --open)    open_flag=1 ;;
    --rescan)  rescan_flag=1 ;;
    --if-due)  ifdue_flag=1 ;;
    --)        shift; while [ $# -gt 0 ]; do TARGETS+=("$1"); shift; done; break ;;
    -*)        echo "osv-daily: unknown option: $1" >&2; usage_err ;;
    *)         TARGETS+=("$1") ;;
  esac
  shift
done
if [ "$open_flag" = 1 ] && { [ "$rescan_flag" = 1 ] || [ "$ifdue_flag" = 1 ]; }; then
  echo "osv-daily: --open cannot be combined with --rescan or --if-due" >&2
  exit 2
fi
# Default target = the whole home folder (with exclusions applied at scan time).
if [ "${#TARGETS[@]}" -eq 0 ]; then
  TARGETS=("$HOME")
fi
# A single, stable, comparable string representing the whole scanned set — used
# for the report header and the state file's `target` (so a later diff can tell
# "same target set"). Space-joined; just $HOME when defaulted.
TARGET_STR="${TARGETS[*]}"

# Directory exclusions always passed to osv-scanner (exact dirname match, via its
# repeatable --experimental-exclude). A whole-home scan would otherwise crawl
# huge system/cache trees; these are the non-repo heavyweights. osv-scanner
# already skips .gitignore'd files, which covers in-repo node_modules etc.
# Harmless on small/explicit targets (a dirname simply won't be present).
EXCLUDE_DIRS=(Library Caches .cache .Trash .git node_modules .cargo .rustup .npm go .gradle .m2 Applications)
EXCLUDE_ARGS=()
for _d in "${EXCLUDE_DIRS[@]}"; do EXCLUDE_ARGS+=(--experimental-exclude "$_d"); done

REPORT="$HOME/.hiveguard/osv-projects.html"
STATE="${HIVEGUARD_STATE:-$HOME/.hiveguard/osv-last-scan.json}"

# --- open-or-rescan gate (evaluated before any scan) -----------------------
report_is_today() { [ -f "$REPORT" ] && [ "$(stat -f %Sm -t %Y-%m-%d "$REPORT" 2>/dev/null)" = "$(date +%Y-%m-%d)" ]; }

# print the recovered summary from the last scan's state file (Part B).
print_last_summary() {
  STATE="$STATE" REPORT="$REPORT" python3 - <<'PYEOF' || true
import json, os, sys
state, report = os.environ["STATE"], os.environ["REPORT"]
try:
    with open(state) as f:
        s = json.load(f)
    c = s["counts"]; a = c["active"]; k = c["acked"]
    new = f" · {c['new_vulns']} new" if c.get("new_vulns", 0) > 0 else ""
    print(f"Last scan: {s['stamp']} ({s['target']})")
    print(f"  active: {a['projects']} project(s), {a['pkgs']} package(s), "
          f"{a['vulns']} vuln(s), {a['crit']} critical{new}")
    print(f"  acknowledged: {k['vulns']} vuln(s) in {k['pkgs']} package(s)")
    print(f"Report: {report}")
except Exception:
    print("Summary unavailable (no state from a previous scan — it will appear after the next scan).")
PYEOF
}

if [ "$open_flag" = 1 ]; then
  if [ -f "$REPORT" ]; then
    print_last_summary   # "I missed the notification" recovery, before opening
    report_is_today || echo "Note: report is from $(stat -f %Sm -t %Y-%m-%d "$REPORT" 2>/dev/null) and may be stale." >&2
    open "$REPORT"
    exit 0
  fi
  echo "No report yet at $REPORT — run osv-daily to create one." >&2
  exit 1
elif [ "$rescan_flag" = 1 ]; then
  :   # always scan, never prompt
elif [ "$ifdue_flag" = 1 ]; then
  if report_is_today; then exit 0; fi   # fresh → nothing to do, silently
  # else: scan silently
elif [ -t 0 ] && [ -t 1 ]; then
  if report_is_today; then
    print_last_summary   # show the recovered summary before opening + prompting
    open "$REPORT"
    printf 'Rescan now? [y/N] ' >&2
    read -r ans || ans=""
    case "$ans" in y|Y) : ;; *) exit 0 ;; esac
  fi
  # no today's report → scan immediately, no prompt
fi
# no flag + non-interactive (launchd, pipe) → fall through and scan silently

ACKS="${HIVEGUARD_ACKS:-$HOME/.hiveguard/osv-acks.json}"
JSON="$(mktemp)"; COUNTS="$(mktemp)"
trap 'rm -f "$JSON" "$COUNTS"' EXIT
LOGDIR="$HOME/.hiveguard"; mkdir -p "$LOGDIR" "$(dirname "$REPORT")"
STAMP="$(date '+%Y-%m-%d %H:%M')"

command -v osv-scanner >/dev/null || { echo "osv-scanner not found"; exit 1; }

# bumblebee layer: keep the catalog fresh (install-gate)
if [ -d "$HOME/bumblebee-src/.git" ]; then
  git -C "$HOME/bumblebee-src" pull --quiet 2>/dev/null || true
fi

# one scan over all target folders (with the default exclusions applied)
osv-scanner scan source --recursive --format json "${EXCLUDE_ARGS[@]}" "${TARGETS[@]}" > "$JSON" 2>/dev/null || true
[ -s "$JSON" ] || { echo '{"results":[]}' > "$JSON"; }

# compact HTML report. Python owns the counts because it also applies the
# acknowledgement filter, then writes the active/acked tallies to $COUNTS.
JSON="$JSON" OUT="$REPORT" STAMP="$STAMP" TARGET="$TARGET_STR" ACKS="$ACKS" COUNTS="$COUNTS" STATE="$STATE" python3 <<'PYEOF'
import json, os, html, re, shlex
d = json.load(open(os.environ["JSON"]))
def ig(k, dv=""):
    return os.environ.get(k, dv)

# --- dedup scan results by source path -------------------------------------
# osv-scanner can emit the SAME source.path more than once (multiple extractors
# over one manifest, e.g. a requirements.txt). Left as-is that double-counts
# projects/packages/vulns everywhere. Merge results by path up front so every
# tally, finding, and report row below is computed from one entry per path.
#   - group results by source.path (keep the first result's other source fields)
#   - within a group, merge packages by package name: union each package's
#     vulnerabilities deduped by vuln id (keep the first package dict's other
#     fields); concatenate groups so the later max_severity is the group maximum.
def merge_results(results):
    by_path, order = {}, []
    for r in results:
        path = (r.get("source", {}) or {}).get("path", "")
        grp = by_path.get(path)
        if grp is None:
            grp = by_path[path] = {"source": dict(r.get("source", {}) or {}),
                                   "packages": {}, "order": []}
            order.append(path)
        for p in r.get("packages", []) or []:
            name = (p.get("package", {}) or {}).get("name", "")
            mp = grp["packages"].get(name)
            if mp is None:
                mp = dict(p)   # keep this first package dict's other fields
                mp["vulnerabilities"] = list(p.get("vulnerabilities") or [])
                mp["groups"] = list(p.get("groups") or [])
                grp["packages"][name] = mp
                grp["order"].append(name)
            else:
                seen = {v.get("id") for v in mp["vulnerabilities"]}
                for v in (p.get("vulnerabilities") or []):
                    if v.get("id") not in seen:
                        mp["vulnerabilities"].append(v); seen.add(v.get("id"))
                mp["groups"].extend(p.get("groups") or [])   # max_severity = max
    return [{"source": by_path[path]["source"],
             "packages": [by_path[path]["packages"][n] for n in by_path[path]["order"]]}
            for path in order]

d["results"] = merge_results(d.get("results", []))

# --- baseline for the "new since last scan" diff ---------------------------
# Read the EXISTING state file BEFORE this run overwrites it at the end. The
# diff is valid ONLY when a prior scan exists AND it covered the same target
# set — otherwise an absent/mismatched baseline would mark everything "new".
prev = None
try:
    with open(os.environ.get("STATE", "")) as f:
        prev = json.load(f)
except Exception:
    prev = None
baseline_findings = (prev or {}).get("findings", {}) or {}
baseline_target = (prev or {}).get("target")
baseline_valid = prev is not None and baseline_target is not None and baseline_target == ig("TARGET")

# current union of ALL vulnerable findings (active AND acked), straight from the
# raw scan results — used both for the state file and the resolved-since diff.
cur_findings = {}
for r in d.get("results", []):
    src = r.get("source", {}).get("path", "")
    for p in r.get("packages", []):
        vulns = p.get("vulnerabilities") or []
        if not vulns: continue
        name = p.get("package", {}).get("name", "")
        cur_findings.setdefault(src, {})[name] = [v.get("id", "") for v in vulns]

# --- acknowledgements ------------------------------------------------------
ack_projects, ack_packages = set(), {}
try:
    with open(os.environ.get("ACKS", "")) as f:
        a = json.load(f)
    ack_projects = set(a.get("projects", []) or [])
    ack_packages = {k: set(v) for k, v in (a.get("packages", {}) or {}).items()}
except Exception:
    pass

def is_acked(src, name):
    return src in ack_projects or name in ack_packages.get(src, set())

def vtuple(v):
    return tuple(int(x) for x in re.findall(r'\d+', v or "")[:4]) or (0,)

def sev_bucket(score):
    try: s = float(score)
    except: return ("low", "LOW")
    if s >= 9: return ("crit", "CRIT")
    if s >= 7: return ("high", "HIGH")
    if s >= 4: return ("med",  "MED")
    return ("low", "LOW")

# split every project's vulnerable packages into active vs acknowledged
active, acked = [], []
for r in d.get("results", []):
    src = r.get("source", {}).get("path", "")
    act_pkgs, ack_pkgs = [], []
    for p in r.get("packages", []):
        vulns = p.get("vulnerabilities") or []
        if not vulns: continue
        info = p.get("package", {})
        maxsev = max((float(g.get("max_severity", "0") or 0) for g in (p.get("groups") or [])), default=0.0)
        fixes = []
        for v in vulns:
            for a in v.get("affected", []) or []:
                for rng in a.get("ranges", []) or []:
                    for e in rng.get("events", []) or []:
                        if e.get("fixed"): fixes.append(e["fixed"])
        pkg = {
            "name": info.get("name", ""), "version": info.get("version", ""),
            "eco": info.get("ecosystem", ""), "sev": maxsev,
            "fix": max(fixes, key=vtuple) if fixes else "",
            "count": len(vulns), "ids": [v.get("id", "") for v in vulns],
        }
        # advisory ids not present for this (src, pkg) in the previous scan
        base_ids = baseline_findings.get(src, {}).get(pkg["name"], []) if baseline_valid else []
        pkg["new_ids"] = [i for i in pkg["ids"] if i not in base_ids] if baseline_valid else []
        (ack_pkgs if is_acked(src, pkg["name"]) else act_pkgs).append(pkg)
    if act_pkgs:
        act_pkgs.sort(key=lambda x: x["sev"], reverse=True)
        active.append({"src": src, "pkgs": act_pkgs, "maxsev": max(p["sev"] for p in act_pkgs)})
    if ack_pkgs:
        ack_pkgs.sort(key=lambda x: x["sev"], reverse=True)
        acked.append({"src": src, "pkgs": ack_pkgs, "maxsev": max(p["sev"] for p in ack_pkgs),
                      "whole": src in ack_projects})
active.sort(key=lambda x: x["maxsev"], reverse=True)
acked.sort(key=lambda x: x["maxsev"], reverse=True)

def tally(projlist):
    vulns = sum(p["count"] for pr in projlist for p in pr["pkgs"])
    pkgs  = sum(len(pr["pkgs"]) for pr in projlist)
    crit  = sum(1 for pr in projlist for p in pr["pkgs"] if p["sev"] >= 9)
    return len(projlist), pkgs, vulns, crit
a_proj, a_pkg, a_vuln, a_crit = tally(active)
k_proj, k_pkg, k_vuln, k_crit = tally(acked)

# --- new / resolved since last scan (computed only when baseline is valid) --
# NEW = active finding keys (src, pkg, id) absent from the baseline union.
# RESOLVED = baseline union keys absent from the current union.
new_vulns = sum(len(p["new_ids"]) for pr in active for p in pr["pkgs"]) if baseline_valid else 0
resolved_vulns = 0
if baseline_valid:
    cur_keys = {(s, n, i) for s, pk in cur_findings.items() for n, ids in pk.items() for i in ids}
    resolved_vulns = sum(1 for s, pk in baseline_findings.items() for n, ids in pk.items()
                         for i in ids if (s, n, i) not in cur_keys)

# hand the active/acked counts back to the shell (notification + log)
cf = os.environ.get("COUNTS", "")
if cf:
    with open(cf, "w") as f:
        f.write(f"ACTIVE_PROJECTS={a_proj}\nACTIVE_PKGS={a_pkg}\nACTIVE_VULNS={a_vuln}\nACTIVE_CRIT={a_crit}\n")
        f.write(f"ACKED_PROJECTS={k_proj}\nACKED_PKGS={k_pkg}\nACKED_VULNS={k_vuln}\nACKED_CRIT={k_crit}\n")
        f.write(f"NEW_VULNS={new_vulns}\nRESOLVED_VULNS={resolved_vulns}\n")

# --- last-scan state file (baseline for a future diff task) ----------------
# findings = union of ALL vulnerable findings (active AND acknowledged),
# collected straight from the raw scan results so ack state doesn't matter.
sf = os.environ.get("STATE", "")
if sf:
    state = {
        "schema": 1,
        "stamp": ig("STAMP"),
        "target": ig("TARGET"),
        "counts": {
            "active": {"projects": a_proj, "pkgs": a_pkg, "vulns": a_vuln, "crit": a_crit},
            "acked":  {"projects": k_proj, "pkgs": k_pkg, "vulns": k_vuln, "crit": k_crit},
            "new_vulns": new_vulns, "resolved_vulns": resolved_vulns,
        },
        "findings": cur_findings,
    }
    os.makedirs(os.path.dirname(sf) or ".", exist_ok=True)
    tmp = sf + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, indent=2)
    os.replace(tmp, sf)

def short(src):
    return html.escape(src.replace(os.path.expanduser("~/Projects/"), ""))

def cp_btn(cmd, label):
    return (f'<button class="cp" type="button" data-cmd="{html.escape(cmd)}" '
            f'title="Copy this command, then paste it in your terminal">{html.escape(label)}</button>')

def pkg_row(p, src, muted):
    cls, lbl = sev_bucket(p["sev"])
    # NEW badge + accented links apply to active rows only (matches the tile count)
    new_ids = set(p.get("new_ids") or []) if not muted else set()
    idlinks = " ".join(
        f'<a class="{"new" if i in new_ids else ""}" '
        f'href="https://osv.dev/{html.escape(i)}" target="_blank" rel="noopener">{html.escape(i)}</a>'
        for i in p["ids"][:4])
    more = f' <span class="more">+{len(p["ids"])-4}</span>' if len(p["ids"]) > 4 else ""
    badge = f'<span class="newbadge">NEW +{len(new_ids)}</span>' if new_ids else ""
    fix = html.escape(p["fix"]) if p["fix"] else '<span class="none">—</span>'
    if muted:
        btn = cp_btn("hiveguard ack --remove " + shlex.quote(src) + " " + shlex.quote(p["name"]), "unmute")
    else:
        btn = cp_btn("hiveguard ack " + shlex.quote(src) + " " + shlex.quote(p["name"]), "mute")
    return (f'<tr><td class="pk">{html.escape(p["name"])}<span class="eco">{html.escape(p["eco"])}</span></td>'
            f'<td class="mono">{html.escape(p["version"])}</td>'
            f'<td><span class="sev {cls}">{lbl} {p["sev"]:.1f}</span>{badge}</td>'
            f'<td class="mono fix">{fix}</td>'
            f'<td class="ids">{idlinks}{more}</td>'
            f'<td class="act">{btn}</td></tr>')

def proj_card(pr, muted):
    rows = "".join(pkg_row(p, pr["src"], muted) for p in pr["pkgs"])
    pcls, plbl = sev_bucket(pr["maxsev"])
    if muted:
        head_btn = cp_btn("hiveguard ack --remove " + shlex.quote(pr["src"]), "unmute all")
        whole = '<span class="whole">whole project</span>' if pr.get("whole") else ''
        last = "Unmute"
    else:
        head_btn = cp_btn("hiveguard ack " + shlex.quote(pr["src"]), "mute project")
        whole = ''
        last = "Mute"
    return (f'<details class="proj{" acked" if muted else ""}"><summary>'
            f'<span class="chev">▶</span>'
            f'<span class="sev {pcls}">{plbl} {pr["maxsev"]:.1f}</span>'
            f'<span class="pname">{short(pr["src"])}</span>{whole}'
            f'<span class="cnt">{len(pr["pkgs"])} packages</span>{head_btn}</summary>'
            f'<div class="tblwrap"><table><thead><tr><th>Package</th><th>Version</th>'
            f'<th>Max severity</th><th>Fixed in</th><th>IDs</th><th class="acth">{last}</th></tr></thead>'
            f'<tbody>{rows}</tbody></table></div></details>')

if active:
    body = "".join(proj_card(pr, False) for pr in active)
elif acked:
    body = '<p class="clean">✅ No active vulnerabilities — everything found is acknowledged.</p>'
else:
    body = '<p class="clean">✅ No known vulnerabilities found.</p>'

toolbar = '<div class="toolbar"><button class="btn" id="toggleAll" type="button">Expand all</button></div>' if active else ''

acked_html = ""
if acked:
    acked_html = (
        '<details class="ackwrap"><summary>'
        f'Acknowledged — {k_proj} project(s), {k_pkg} package(s), {k_vuln} vuln(s) muted'
        '</summary>'
        '<p class="ackhint">Excluded from the totals above and from the daily alert. '
        'Copy an “unmute” command to bring one back into the count.</p>'
        + "".join(proj_card(pr, True) for pr in acked) +
        '</details>')

vuln_l = "vulnerabilities" + (f' · +{k_vuln} muted' if k_vuln else '')
lede_extra = (' Muted projects/findings are excluded — see <b>Acknowledged</b> at the bottom.'
              if acked else '')

page = f'''<meta charset="utf-8">
<title>OSV — projects</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
:root{{--bg:#eef1f3;--surface:#f9fbfc;--surface-2:#e5eaed;--text:#161b1f;--muted:#5b666d;--faint:#8a959c;
--border:#dae0e4;--border-strong:#c6ced3;--accent:#2367a8;
--crit:#c02636;--crit-s:#f5dade;--high:#c85a1c;--high-s:#f4e2d2;--med:#a9861f;--med-s:#f1e9d0;--low:#4a7a52;--low-s:#dfeadf;
--mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace;--sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;}}
@media (prefers-color-scheme:dark){{:root:not([data-theme="light"]){{--bg:#0e1316;--surface:#161d21;--surface-2:#1f272c;
--text:#e4eaed;--muted:#9aa5ac;--faint:#6d777d;--border:#242d32;--border-strong:#333e44;--accent:#5199db;
--crit:#e5606c;--crit-s:#3a1519;--high:#e08a4d;--high-s:#33200f;--med:#d6b256;--med-s:#312810;--low:#6db874;--low-s:#15301a;}}}}
:root[data-theme="dark"]{{--bg:#0e1316;--surface:#161d21;--surface-2:#1f272c;--text:#e4eaed;--muted:#9aa5ac;--faint:#6d777d;
--border:#242d32;--border-strong:#333e44;--accent:#5199db;--crit:#e5606c;--crit-s:#3a1519;--high:#e08a4d;--high-s:#33200f;
--med:#d6b256;--med-s:#312810;--low:#6db874;--low-s:#15301a;}}
*{{box-sizing:border-box}}body{{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans);line-height:1.5;-webkit-font-smoothing:antialiased}}
.wrap{{max-width:940px;margin:0 auto;padding:0 20px 90px}}
header{{padding:44px 0 20px;border-bottom:1px solid var(--border)}}
.eyebrow{{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin:0 0 10px}}
h1{{font-size:clamp(26px,5vw,38px);margin:0 0 8px;letter-spacing:-.02em}}
.lede{{color:var(--muted);font-size:15px;margin:0}}
.stats{{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}}
.stat{{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:9px 14px;min-width:96px}}
.stat .n{{font-family:var(--mono);font-size:22px;font-weight:600;font-variant-numeric:tabular-nums}}.stat .l{{font-size:11px;color:var(--muted)}}
.stat.crit .n{{color:var(--crit)}}
.stat.new .n{{color:var(--accent)}}
.newbadge{{font-family:var(--mono);font-size:10px;font-weight:600;margin-left:7px;padding:1px 6px;border-radius:5px;white-space:nowrap;background:var(--accent);color:#fff;letter-spacing:.02em}}
details.proj{{margin-top:10px;border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--surface)}}
details.proj.acked{{opacity:.72}}
details.proj>summary{{cursor:pointer;list-style:none;display:flex;align-items:center;gap:12px;padding:11px 14px;font-family:var(--mono);font-size:14px}}
details.proj>summary::-webkit-details-marker{{display:none}}
details.proj>summary:hover{{background:var(--surface-2)}}
.chev{{color:var(--faint);transition:transform .15s;font-size:11px}}
details.proj[open]>summary .chev{{transform:rotate(90deg)}}
.pname{{flex:1;font-weight:600;word-break:break-word}}
.cnt{{font-size:12px;color:var(--faint);font-weight:400;white-space:nowrap}}
.whole{{font-family:var(--mono);font-size:10px;color:var(--faint);border:1px solid var(--border-strong);border-radius:5px;padding:1px 6px;white-space:nowrap}}
.tblwrap{{overflow-x:auto;border:none;border-top:1px solid var(--border)}}
.toolbar{{display:flex;justify-content:flex-end;margin-top:20px;margin-bottom:-4px}}
