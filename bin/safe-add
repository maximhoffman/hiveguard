#!/usr/bin/env bash
# safe-add — install a package ONLY after it clears the OSV database.
# Resolves the dependency tree WITHOUT installing → scans with osv-scanner → installs if clean.
# Layers: OSV (this check) + bumblebee (kicks in automatically on npm/pip/go/cargo at install).
#
# Policy:
#   - MAL-* (malicious package)   -> HARD STOP
#   - critical (CVSS >= 9)        -> STOP (override with --force)
#   - other CVEs                  -> warning, install proceeds
#
# Usage:
#   safe-add npm  react-router
#   safe-add npm  react-router -g        # extra args pass through to install
#   safe-add pip  requests
#   safe-add uv   serena-agent           # uv tool install
#   safe-add gem  nokogiri               # coarse check (name only, no tree)
#   safe-add cargo ripgrep
#   Flags:
#     --force        install anyway despite a critical/MAL verdict — use once
#                    you've reviewed the findings and accept the risk
#     --check-only   run the OSV check and print the verdict, but skip the
#                    install — use to preview risk before deciding
#     -h, --help     show this help
#
# Full-tree ecosystems: npm, pnpm, yarn, bun, pip, uv.
# Coarse (top-level package via OSV API): gem, cargo, go, composer.
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

FORCE=0; CHECK_ONLY=0; ARGS=()
for a in "$@"; do
  case "$a" in
    --force) FORCE=1 ;;
    --check-only) CHECK_ONLY=1 ;;
    -h|--help) grep '^#' "$0" | grep -v '/usr/bin/env' | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) ARGS+=("$a") ;;
  esac
done
[ "${#ARGS[@]}" -ge 2 ] || { echo "usage: safe-add <manager> <package> [args]"; exit 2; }
MGR="${ARGS[0]}"; PKG="${ARGS[1]}"; EXTRA=("${ARGS[@]:2}")

command -v osv-scanner >/dev/null || { echo "osv-scanner not found (brew install osv-scanner)"; exit 1; }
command -v jq >/dev/null || { echo "jq required"; exit 1; }

RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'; DIM=$'\033[2m'; BLD=$'\033[1m'; NC=$'\033[0m'
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT

# -- resolve the tree without installing -> path to a lockfile/requirements --
resolve_lockfile() {
  case "$MGR" in
    npm|pnpm|yarn|bun)
      ( cd "$TMP" && npm init -y >/dev/null 2>&1 \
        && npm install "$PKG" --package-lock-only --ignore-scripts --no-audit --no-fund >/dev/null 2>&1 ) || return 1
      [ -f "$TMP/package-lock.json" ] && echo "$TMP/package-lock.json" || return 1 ;;
    pip)
      python3 -m pip install "$PKG" --dry-run --quiet --report "$TMP/r.json" >/dev/null 2>&1 || return 1
      jq -r '.install[]?.metadata | "\(.name)==\(.version)"' "$TMP/r.json" > "$TMP/requirements.txt" 2>/dev/null
      [ -s "$TMP/requirements.txt" ] && echo "$TMP/requirements.txt" || return 1 ;;
    uv)
      printf '%s\n' "$PKG" | uv pip compile - -o "$TMP/requirements.txt" --quiet 2>/dev/null || return 1
      [ -s "$TMP/requirements.txt" ] && echo "$TMP/requirements.txt" || return 1 ;;
    *) return 2 ;;  # coarse mode
  esac
}

# -- coarse: check a single package via the OSV API --------------------------
osv_ecosystem() {
  case "$MGR" in
    gem) echo "RubyGems" ;; cargo) echo "crates.io" ;; go) echo "Go" ;;
    composer) echo "Packagist" ;; *) echo "" ;;
  esac
}

VERDICT="clean"  # clean | warn | block
print_findings_lockfile() {  # $1 = json
  local j="$1"
  local mal crit high total
  mal=$(jq '[.results[]?.packages[]?.vulnerabilities[]?.id | select(startswith("MAL-"))]|length' <<<"$j")
  crit=$(jq '[.results[]?.packages[]?.groups[]?.max_severity | (tonumber? // 0) | select(.>=9)]|length' <<<"$j")
  high=$(jq '[.results[]?.packages[]?.groups[]?.max_severity | (tonumber? // 0) | select(.>=7 and .<9)]|length' <<<"$j")
  total=$(jq '[.results[]?.packages[]?.vulnerabilities[]?]|length' <<<"$j")
  local pkgs; pkgs=$(jq '[.results[]?.packages[]?]|length' <<<"$j")
  echo "${DIM}vulnerable packages in tree: $pkgs${NC}"
  if [ "$total" -gt 0 ]; then
    jq -r '
      .results[]?.packages[]? as $p | ($p.vulnerabilities // []) | select(length>0) |
      ($p.package.name) as $n | ($p.package.version) as $v |
      ([$p.groups[]?.max_severity | (tonumber? // 0)] | max // 0) as $s |
      ([.[].id] | map(select(startswith("MAL-"))) | length) as $m |
      "\($n)@\($v)\t\($s)\t\($m)\t\([.[].id]|join(","))"
    ' <<<"$j" 2>/dev/null | while IFS=$'\t' read -r nv sev malc ids; do
      tag="CVE"; col="$YEL"
      awk "BEGIN{exit !($sev>=9)}" && { tag="CRIT"; col="$RED"; }
      [ "${malc:-0}" -gt 0 ] && { tag="MAL"; col="$RED$BLD"; }
      printf "  %s%-5s%s %-28s %s\n" "$col" "$tag" "$NC" "$nv" "${DIM}${ids}${NC}"
    done
  fi
  echo
  if [ "$mal" -gt 0 ]; then
    echo "${RED}${BLD}✖ MALICIOUS packages (MAL): $mal — install blocked${NC}"; VERDICT="block"
  elif [ "$crit" -gt 0 ]; then
    echo "${RED}✖ critical (CVSS≥9): $crit${NC}"; VERDICT="block"
  elif [ "$total" -gt 0 ]; then
    echo "${YEL}⚠ vulnerabilities present ($total; high: $high), none critical — proceeding${NC}"; VERDICT="warn"
  else
    echo "${GRN}✓ clean per OSV${NC}"; VERDICT="clean"
  fi
}

print_findings_api() {  # coarse
  local eco; eco="$(osv_ecosystem)"
  [ -n "$eco" ] || { echo "${YEL}⚠ ecosystem '$MGR' unsupported for scanning — installing without the OSV gate${NC}"; VERDICT="warn"; return; }
  echo "${DIM}coarse mode: checking only the package '$PKG' via the OSV API (no tree)${NC}"
  local body resp mal total
  body=$(printf '{"package":{"name":"%s","ecosystem":"%s"}}' "$PKG" "$eco")
  resp=$(curl -s -X POST 'https://api.osv.dev/v1/query' -H 'Content-Type: application/json' -d "$body" || echo '{}')
  total=$(jq '(.vulns // [])|length' <<<"$resp" 2>/dev/null || echo 0)
  mal=$(jq '[(.vulns // [])[].id | select(startswith("MAL-"))]|length' <<<"$resp" 2>/dev/null || echo 0)
  if [ "${mal:-0}" -gt 0 ]; then
    echo "${RED}${BLD}✖ package is listed as MALICIOUS (MAL) in OSV — stop${NC}"; VERDICT="block"
  elif [ "${total:-0}" -gt 0 ]; then
    echo "${YEL}⚠ package has OSV records ($total) — see https://osv.dev/list?q=$PKG${NC}"; VERDICT="warn"
  else
    echo "${GRN}✓ no OSV records${NC}"; VERDICT="clean"
  fi
}

# -- real install (the bumblebee gate turns itself on) -----------------------
do_install() {
  # Resolve this script's own real directory (follow symlinks) so we can find
  # a sibling bumblebee-guard.sh — e.g. under a Homebrew libexec/bin layout,
  # where there is no ~/bin symlink.
  local src="$0" self_dir n=0
  while [ -L "$src" ]; do
    n=$((n + 1)); [ "$n" -gt 10 ] && break
    local target; target="$(readlink "$src")"
    case "$target" in
      /*) src="$target" ;;
      *)  src="$(cd "$(dirname "$src")" && pwd)/$target" ;;
    esac
  done
  self_dir="$(cd "$(dirname "$src")" && pwd)"
  # shellcheck disable=SC1090,SC1091
  if [ -f "$self_dir/bumblebee-guard.sh" ]; then
    source "$self_dir/bumblebee-guard.sh" 2>/dev/null || true
  elif [ -f "$HOME/bin/bumblebee-guard.sh" ]; then
    source "$HOME/bin/bumblebee-guard.sh" 2>/dev/null || true
  fi
  echo "${BLD}→ installing: $MGR $PKG ${EXTRA[*]:-}${NC}"
  case "$MGR" in
    npm)  npm install "$PKG" "${EXTRA[@]}" ;;
    pnpm) pnpm add "$PKG" "${EXTRA[@]}" ;;
    yarn) yarn add "$PKG" "${EXTRA[@]}" ;;
    bun)  bun add "$PKG" "${EXTRA[@]}" ;;
    pip)  python3 -m pip install "$PKG" "${EXTRA[@]}" ;;
    uv)   uv tool install "$PKG" "${EXTRA[@]}" ;;
    gem)  gem install "$PKG" "${EXTRA[@]}" ;;
    cargo) cargo install "$PKG" "${EXTRA[@]}" ;;
    go)   go install "$PKG" "${EXTRA[@]}" ;;
    *) echo "don't know how to install '$MGR'"; return 1 ;;
  esac
}

echo "${BLD}safe-add:${NC} checking ${BLD}$PKG${NC} (${MGR}) against OSV..."
if lf="$(resolve_lockfile)"; then
  json=$(osv-scanner scan source -L "$lf" --format json 2>/dev/null) || true  # exit 1 = vulnerabilities found, normal
  [ -n "$json" ] || json='{"results":[]}'
  print_findings_lockfile "$json"
else
  rc=$?
  if [ "$rc" -eq 2 ]; then print_findings_api
  else echo "${YEL}⚠ could not build the tree (resolve failed) — installing without the gate is risky${NC}"; VERDICT="warn"; fi
fi

echo
if [ "$VERDICT" = "block" ] && [ "$FORCE" -ne 1 ]; then
  echo "${RED}Install cancelled. Override deliberately with --force${NC}"; exit 1
fi
[ "$VERDICT" = "block" ] && echo "${YEL}--force: installing despite critical/MAL${NC}"
if [ "$CHECK_ONLY" -eq 1 ]; then echo "${DIM}--check-only: skipping install${NC}"; exit 0; fi
do_install
